{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "cicada": {
      "type": "local",
      "command": ["uvx", "cicada-mcp", "server", "--watch"],
      "cwd": ".",
      "enabled": true
    }
  }
}
