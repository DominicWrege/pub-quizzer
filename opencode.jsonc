{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "cicada": {
      "type": "local",
      "command": [".venv/bin/cicada-mcp", "server", "--watch"],
      "cwd": ".",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--headless", "--executable-path", "/home/dominic/.nix-profile/bin/chromium"],
      "enabled": true
    }
  }
}
