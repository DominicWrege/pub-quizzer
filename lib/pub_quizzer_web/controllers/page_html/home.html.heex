<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  max_width="max-w-full"
  main_class="px-4 sm:px-6 lg:px-8"
>
  <div class="flex items-start sm:items-center justify-center min-h-[calc(100vh-4rem)] pt-32 sm:pt-0">
    <div class="text-center max-w-sm">
      <.icon name="hero-trophy" class="size-[5rem] mx-auto text-warning" />
      <h1 class="text-4xl font-bold mt-4">Quiz for a better life</h1>
      <p class="pt-4 pb-2 text-base-content/70">
        Gib den Code ein, der vom Moderator angezeigt wird.
      </p>

      <form action="/quiz/join" method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <.input
          name="code"
          id="home-quiz-code"
          type="text"
          placeholder="z.B. 4827"
          maxlength="4"
          pattern="[0-9]{4}"
          inputmode="numeric"
          value=""
          required
        />
        <button type="submit" class="btn btn-primary btn-block mt-4">Beitreten</button>
      </form>
    </div>
  </div>
</Layouts.app>
