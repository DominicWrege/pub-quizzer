<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  max_width="max-w-full"
  main_class="px-4 sm:px-6 lg:px-8"
>
  <div class="flex items-start sm:items-center justify-center min-h-[calc(100vh-4rem)] pt-32 sm:pt-0">
    <div class="text-center max-w-sm">
      <p class="pb-2 text-base-content/70">
        Gib den Code ein, der vom Moderator angezeigt wird.
      </p>

      <form action="/quiz/join" method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input
          type="text"
          name="code"
          id="home-quiz-code"
          placeholder="z.B. 4827"
          maxlength="4"
          pattern="[0-9]{4}"
          inputmode="numeric"
          required
          class="w-full input font-mono text-center tracking-widest"
          oninput="document.getElementById('home-join-btn').disabled=this.value.replace(/\D/g,'').length!==4"
        />
        <button
          type="submit"
          class="btn btn-primary btn-block mt-4"
          id="home-join-btn"
          disabled
        >
          Beitreten
        </button>
      </form>
    </div>
  </div>
</Layouts.app>
