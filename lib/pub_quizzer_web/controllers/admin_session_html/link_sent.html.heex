<Layouts.app flash={@flash} max_width="max-w-full" main_class="px-4 sm:px-6 lg:px-8">
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-base-200/50">
    <div class="card bg-base-100 shadow-lg border border-base-300 w-full max-w-md mx-4 relative overflow-hidden">
      <div class="card-body items-center text-center pt-10 pb-8">
        <div class="flex items-center justify-center size-16 rounded-full bg-success/20">
          <.icon name="hero-check-circle" class="size-8 text-success" />
        </div>

        <h1 class="card-title text-2xl mt-6">Link gesendet!</h1>

        <p class="text-base-content/70 mt-2 leading-relaxed">
          Wir haben dir einen Login-Link an <strong class="text-base-content">{@email}</strong>
          gesendet.
        </p>

        <p class="text-base-content/60 text-sm mt-1">
          Prüfe dein Postfach und klicke auf den Link, um dich anzumelden.
        </p>

        <div class="divider mt-8"></div>

        <div class="w-full text-left">
          <p class="text-sm font-medium text-base-content/70 mb-3">Keine E-Mail erhalten?</p>

          <ul class="text-sm text-base-content/60 space-y-2">
            <li class="flex items-start gap-2">
              <span class="text-primary/70 mt-0.5 shrink-0">•</span>
              <span>Spam-Ordner prüfen</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary/70 mt-0.5 shrink-0">•</span>
              <span>Der Link ist 10 Minuten gültig</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary/70 mt-0.5 shrink-0">•</span>
              <.link
                navigate={~p"/admin/login"}
                class="text-primary hover:underline font-semibold"
              >
                Neuen Link anfordern
              </.link>
            </li>
          </ul>
        </div>

        <div class="mt-8">
          <.link navigate={~p"/"} class="link link-hover text-sm text-base-content/60">
            Zurück zur Startseite
          </.link>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
