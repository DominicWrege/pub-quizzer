<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Quiz for a better life" suffix="" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="alternate icon" href={~p"/favicon.ico"} />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <meta name="theme-color" content="#f6f2e7" />
    <meta name="color-scheme" content="light" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Quiz" />
    <% og_title = assigns[:page_title] || "Quiz for a better life" %>
    <% og_desc =
      assigns[:page_description] ||
        "Interaktives Kneipenquiz – Fragen, Antworten und Live-Ergebnisse auf dem Beamer." %>
    <% base_url = PubQuizzerWeb.Endpoint.url() %>
    <meta name="description" content={og_desc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quiz for a better life" />
    <meta property="og:title" content={og_title} />
    <meta property="og:description" content={og_desc} />
    <meta property="og:url" content={base_url <> ~p"/"} />
    <meta property="og:image" content={base_url <> ~p"/images/og-image.png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Quiz for a better life – Kneipenquiz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={og_title} />
    <meta name="twitter:description" content={og_desc} />
    <meta name="twitter:image" content={base_url <> ~p"/images/og-image.png"} />
    <link
      phx-track-static
      rel="stylesheet"
      href={PubQuizzerWeb.Endpoint.static_path("/assets/css/app.css")}
    />
    <%= if assigns[:load_live_socket?] != false do %>
      <script
        defer
        phx-track-static
        type="text/javascript"
        src={PubQuizzerWeb.Endpoint.static_path("/assets/js/app.js")}
      >
      </script>
    <% end %>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
