<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-[1700px]"
>
  <.header>
    <:back>
      <.link navigate={~p"/admin/topics/#{@topic.id}/questions"} class="btn btn-sm btn-soft">
        ← Zurück
      </.link>
    </:back>
    Frage bearbeiten
    <:subtitle>{@topic.name}</:subtitle>
    <:actions>
      <button
        type="submit"
        form="question-form"
        class="btn btn-primary btn-sm gap-1"
      >
        <.icon name="hero-check-circle" class="size-4" /> Speichern
      </button>
    </:actions>
  </.header>

  <div class="lg:grid lg:grid-cols-[2fr_1fr] xl:grid-cols-[3fr_1fr] lg:gap-2">
    <.form
      for={@form}
      id="question-form"
      phx-change="validate"
      phx-submit="save"
      class="bg-base-200 rounded-2xl p-5 sm:p-6 space-y-5 border border-base-300 w-full mx-auto max-w-[1200px]"
    >
      <%!-- Hidden correct index — driven by click-to-select on option cards --%>
      <input type="hidden" name="question[correct_index]" value={@form[:correct_index].value} />

      <%!-- Prompt card --%>
      <div class="card bg-base-100 border border-base-300 shadow-md">
        <div class="card-body p-5 gap-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
              Frage
            </span>
            <%= if @form[:correct_index].value != nil do %>
              <span class="text-xs text-base-content/50">
                Richtige Antwort:
                <span class="font-mono font-bold text-success">
                  {String.capitalize(
                    PubQuizzerWeb.CoreComponents.letter_for_index(@form[:correct_index].value)
                  )}
                </span>
              </span>
            <% end %>
          </div>
          <textarea
            name="question[prompt]"
            id="question_prompt"
            phx-hook="AutoResize"
            class="w-full text-2xl font-semibold leading-relaxed bg-base-100 border-2 border-base-300 rounded-lg outline-none resize-none placeholder:text-base-content/30 focus:outline-none px-3 py-2"
            placeholder="Wie lautet die Frage?"
            rows="2"
          ><%= @form[:prompt].value || "" %></textarea>

          <%!-- Question image upload --%>
          <div
            id="image-upload-zone"
            phx-hook="ImagePreview"
            phx-drop-target={@uploads.image.ref}
            class={[
              "rounded-lg border-2 border-dashed transition-colors",
              @uploads.image.entries != [] && "border-primary bg-primary/5",
              @uploads.image.entries == [] && "border-base-300 hover:border-base-content/30"
            ]}
          >
            <%= cond do %>
              <% entry = List.first(@uploads.image.entries) -> %>
                <div class="p-3 flex items-center gap-3">
                  <span class="text-sm font-medium truncate flex-1">{entry.client_name}</span>
                  <button
                    type="button"
                    phx-click="cancel_upload"
                    phx-value-ref={entry.ref}
                    class="btn btn-xs btn-ghost"
                  >×</button>
                </div>
              <% img = @question.image -> %>
                <div class="relative group">
                  <img
                    src={img}
                    alt="Aktuelles Bild"
                    class="rounded-lg max-h-48 w-full object-cover"
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                    <span class="text-white text-xs">Beim Speichern wird ersetzt</span>
                  </div>
                </div>
                <div class="p-2 text-xs text-base-content/60 text-center border-t border-base-300">
                  Bestehendes Bild. Neue Datei hierher ziehen zum Ersetzen.
                </div>
              <% true -> %>
                <label class="p-4 flex flex-col items-center gap-1 cursor-pointer text-base-content/50 hover:text-base-content/70">
                  <.icon name="hero-photo" class="size-6" />
                  <span class="text-xs">Bild zur Frage (optional)</span>
                  <span class="text-[10px]">Klicken oder Datei hierher ziehen</span>
                  <.live_file_input upload={@uploads.image} class="sr-only" />
                </label>
            <% end %>
          </div>
          <%= if @image_preview_url do %>
            <div class="relative">
              <img src={@image_preview_url} class="rounded-lg max-h-48 w-full object-cover" />
              <button
                type="button"
                phx-click="cancel_upload"
                phx-value-ref={
                  List.first(@uploads.image.entries) && List.first(@uploads.image.entries).ref
                }
                class="btn btn-xs btn-circle absolute top-2 right-2"
              >×</button>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Options --%>
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
            Antwortoptionen
          </span>
          <span class="text-xs text-base-content/50">
            Klick zum Auswählen · Ziehen zum Sortieren
          </span>
        </div>

        <div
          id="question-options"
          class="space-y-2"
          phx-hook="OptionSorter"
          data-correct-index={@form[:correct_index].value}
        >
          <%= for i <- 0..3 do %>
            <% opt_val = Phoenix.HTML.Form.input_value(@form, :options) |> Enum.at(i, %{}) %>
            <% opt_text = (is_map(opt_val) && Map.get(opt_val, "text")) || "" %>
            <% opt_img = (is_map(opt_val) && Map.get(opt_val, "image")) || nil %>
            <% is_correct = @form[:correct_index].value == i %>
            <div
              data-index={i}
              phx-click="select_correct"
              phx-value-index={i}
              class={[
                "opt-row group relative rounded-xl border-2 p-4 transition-all cursor-pointer shadow-md",
                is_correct && "border-success bg-success/10 shadow-lg",
                !is_correct &&
                  "border-base-300 bg-base-100 hover:border-base-content/40 hover:shadow-lg"
              ]}
            >
              <div class="flex items-start gap-3">
                <%!-- Drag handle --%>
                <div class="flex flex-col items-center gap-0.5 pt-2 text-base-content/30 cursor-grab select-none drag-handle hover:text-base-content/60">
                  <span class="leading-none text-lg">⠿</span>
                </div>

                <%!-- Letter label --%>
                <div class={[
                  "font-mono font-bold text-xl w-7 pt-2 shrink-0 text-center",
                  is_correct && "text-success",
                  !is_correct && "text-base-content/50"
                ]}>
                  {String.capitalize(PubQuizzerWeb.CoreComponents.letter_for_index(i))}
                </div>

                <%!-- Text input (transparent, auto-growing, multi-line friendly) --%>
                <textarea
                  name={"question[options][#{i}]"}
                  id={"question_options_#{i}"}
                  data-option-text
                  phx-hook="AutoResize"
                  class="flex-1 bg-base-100 border-2 border-base-300 rounded-lg outline-none resize-none text-lg leading-relaxed placeholder:text-base-content/30 focus:outline-none px-2 py-1.5 min-h-[3.75rem] whitespace-pre-wrap"
                  placeholder={"Option #{String.capitalize(PubQuizzerWeb.CoreComponents.letter_for_index(i))}"}
                  rows="2"
                ><%= opt_text %></textarea>

                <%!-- Correct indicator --%>
                <div class={[
                  "pt-2 shrink-0 transition-opacity",
                  is_correct && "opacity-100",
                  !is_correct && "opacity-0 group-hover:opacity-30"
                ]}>
                  <.icon
                    name="hero-check-circle"
                    class={[
                      "size-5",
                      is_correct && "text-success",
                      !is_correct && "text-base-content/40"
                    ]}
                  />
                </div>
              </div>

              <%!-- Per-option image zone --%>
              <div
                id={"option-image-zone-#{i}"}
                data-option-index={i}
                phx-hook="OptionImagePreview"
                phx-drop-target={@option_uploads[i].ref}
                class="mt-2 ml-12"
              >
                <%= cond do %>
                  <% preview = @option_image_previews[i] -> %>
                    <div class="relative inline-block">
                      <img src={preview} class="h-20 rounded border border-base-300" />
                      <button
                        type="button"
                        phx-click="cancel_option_upload"
                        phx-value-index={i}
                        class="btn btn-xs btn-circle absolute -top-2 -right-2"
                      >×</button>
                    </div>
                  <% img = opt_img -> %>
                    <div class="relative inline-block group">
                      <img src={img} class="h-20 rounded border border-base-300" />
                      <button
                        type="button"
                        phx-click="remove_option_image"
                        phx-value-index={i}
                        class="btn btn-xs btn-circle absolute -top-2 -right-2 opacity-0 group-hover:opacity-100"
                      >×</button>
                    </div>
                  <% true -> %>
                    <label class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-dashed border-base-300 text-xs text-base-content/50 hover:text-base-content/70 hover:border-base-content/30 cursor-pointer transition-colors">
                      <.icon name="hero-photo" class="size-3.5" />
                      <span>Bild</span>
                      <.live_file_input upload={@option_uploads[i]} class="sr-only" />
                    </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%= if @form[:options].errors != [] or @form[:prompt].errors != [] do %>
        <div class="alert alert-error py-2 px-3 text-sm">
          <.icon name="hero-exclamation-circle" class="size-4" />
          <span>
            <%= for {msg, _} <- @form[:prompt].errors do %>
              <span>{msg}</span>
            <% end %>
            <%= for {msg, _} <- @form[:options].errors do %>
              <span>{msg}</span>
            <% end %>
          </span>
        </div>
      <% end %>
    </.form>

    <%!-- Edit history sidebar (visible on lg+) --%>
    <aside class="hidden lg:block">
      <section class="card bg-base-200 border border-base-300 sticky top-4">
        <div class="card-body p-4 gap-3">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-base-content/80">Bearbeitungsverlauf</h3>
            <span class="text-xs text-base-content/50">{length(@versions)} Versionen</span>
          </div>
          <%= if @versions == [] do %>
            <p class="text-sm text-base-content/70 italic">Noch keine Versionen.</p>
          <% else %>
            <div class="space-y-2">
              <%= for {version, diffs} <- @versions do %>
                <div class="rounded-lg border border-base-300 bg-base-100 px-3 py-2">
                  <div class="flex items-center gap-2">
                    <div class="avatar avatar-placeholder">
                      <div class="bg-primary text-primary-content rounded-full w-7">
                        <span class="text-xs font-semibold">
                          {String.at((version.user && version.user.name) || "?", 0)}
                        </span>
                      </div>
                    </div>
                    <div class="min-w-0 flex-1">
                      <span class="font-medium text-sm block truncate">
                        {(version.user && version.user.name) || "Unbekannt"}
                      </span>
                      <span class="text-xs text-base-content/70">
                        {Calendar.strftime(version.inserted_at, "%d.%m.%y %H:%M")}
                      </span>
                    </div>
                  </div>
                  <%= if diffs != [] do %>
                    <ul class="mt-2 space-y-1 text-xs text-base-content/80 border-t border-base-300 pt-2">
                      <%= for diff <- diffs do %>
                        <li class="flex items-start gap-1">
                          <.icon
                            name="hero-pencil"
                            class="size-3 mt-0.5 shrink-0 text-base-content/60"
                          />
                          <%= case diff.field do %>
                            <% :prompt -> %>
                              <span class="font-semibold">Frage geändert</span>
                            <% :options -> %>
                              <span class="font-semibold">Optionen geändert</span>
                            <% :correct_index -> %>
                              <span class="font-semibold">Antwort:</span>
                              {String.capitalize(
                                PubQuizzerWeb.CoreComponents.letter_for_index(diff.old || 0)
                              )} → {String.capitalize(
                                PubQuizzerWeb.CoreComponents.letter_for_index(diff.new || 0)
                              )}
                            <% :image -> %>
                              <%= cond do %>
                                <% is_nil(diff.old) and not is_nil(diff.new) -> %>
                                  <span class="font-semibold">Bild hinzugefügt</span>
                                <% not is_nil(diff.old) and is_nil(diff.new) -> %>
                                  <span class="font-semibold">Bild entfernt</span>
                                <% true -> %>
                                  <span class="font-semibold">Bild geändert</span>
                              <% end %>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    </aside>
  </div>

  <%!-- Edit history (mobile: below the grid) --%>
  <section class="lg:hidden card bg-base-200 border border-base-300">
    <div class="card-body p-5 gap-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-base-content/80">Bearbeitungsverlauf</h3>
        <span class="text-xs text-base-content/50">{length(@versions)} Versionen</span>
      </div>
      <%= if @versions == [] do %>
        <p class="text-sm text-base-content/70 italic">Noch keine Versionen.</p>
      <% else %>
        <div class="space-y-2">
          <%= for {version, diffs} <- @versions do %>
            <div class="rounded-lg border border-base-300 bg-base-100 px-3 py-2">
              <div class="flex items-center gap-2">
                <div class="avatar avatar-placeholder">
                  <div class="bg-primary text-primary-content rounded-full w-7">
                    <span class="text-xs font-semibold">
                      {String.at((version.user && version.user.name) || "?", 0)}
                    </span>
                  </div>
                </div>
                <div class="min-w-0 flex-1">
                  <span class="font-medium text-sm block truncate">
                    {(version.user && version.user.name) || "Unbekannt"}
                  </span>
                  <span class="text-xs text-base-content/70">
                    {Calendar.strftime(version.inserted_at, "%d.%m.%y %H:%M")}
                  </span>
                </div>
              </div>
              <%= if diffs != [] do %>
                <ul class="mt-2 space-y-1 text-xs text-base-content/80 border-t border-base-300 pt-2">
                  <%= for diff <- diffs do %>
                    <li class="flex items-start gap-1">
                      <.icon
                        name="hero-pencil"
                        class="size-3 mt-0.5 shrink-0 text-base-content/60"
                      />
                      <%= case diff.field do %>
                        <% :prompt -> %>
                          <span class="font-semibold">Frage geändert</span>
                        <% :options -> %>
                          <span class="font-semibold">Optionen geändert</span>
                        <% :correct_index -> %>
                          <span class="font-semibold">Antwort:</span>
                          {String.capitalize(
                            PubQuizzerWeb.CoreComponents.letter_for_index(diff.old || 0)
                          )} → {String.capitalize(
                            PubQuizzerWeb.CoreComponents.letter_for_index(diff.new || 0)
                          )}
                        <% :image -> %>
                          <%= cond do %>
                            <% is_nil(diff.old) and not is_nil(diff.new) -> %>
                              <span class="font-semibold">Bild hinzugefügt</span>
                            <% not is_nil(diff.old) and is_nil(diff.new) -> %>
                              <span class="font-semibold">Bild entfernt</span>
                            <% true -> %>
                              <span class="font-semibold">Bild geändert</span>
                          <% end %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</Layouts.app>
