<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-6xl"
>
  <.header>
    <:back>
      <.link navigate={~p"/admin/topics/#{@topic.id}/questions"} class="btn btn-sm btn-soft">
        ← Zurück
      </.link>
    </:back>
    Frage bearbeiten
    <:subtitle>{@topic.name}</:subtitle>
    <:actions>
      <div class="join">
        <button
          type="button"
          phx-click="set_view"
          phx-value-mode="edit"
          class={[
            "btn btn-sm join-item gap-1 border-2",
            (!@show_preview && "btn-primary") || "btn-soft"
          ]}
        >
          <.icon name="hero-pencil" class="size-4" /> Bearbeiten
        </button>
        <button
          type="button"
          phx-click="set_view"
          phx-value-mode="preview"
          class={[
            "btn btn-sm join-item gap-1 border-2",
            (@show_preview && "btn-primary") || "btn-soft"
          ]}
        >
          <.icon name="hero-eye" class="size-4" /> Vorschau
        </button>
      </div>
      <button
        type="submit"
        form="question-form"
        class="btn btn-primary btn-sm gap-1"
        disabled={@show_preview}
      >
        <.icon name="hero-check-circle" class="size-4" /> Speichern
      </button>
    </:actions>
  </.header>

  <div class="grid grid-cols-1 xl:grid-cols-[1fr_320px] gap-6">
    <%!-- Main area: form OR preview (mutually exclusive) --%>
    <div>
      <%= if @show_preview do %>
        <%!-- Preview only --%>
        <div class="card bg-base-200 border border-base-300">
          <div class="card-body">
            <h4 class="card-title text-2xl break-words leading-snug">
              {@form[:prompt].value || "Frage"}
            </h4>
            <%= if img = @question.image do %>
              <img src={img} alt="Fragebild" class="rounded-lg max-h-64 mx-auto mb-2" />
            <% end %>
            <%= if @image_preview_url do %>
              <img
                src={@image_preview_url}
                alt="Neues Bild"
                class="rounded-lg max-h-64 mx-auto mb-2"
              />
            <% end %>
            <div class="flex flex-col gap-3 mt-2">
              <%= for {option, idx} <- Enum.with_index(Phoenix.HTML.Form.input_value(@form, :options) || ["", "", "", ""]) do %>
                <div class={[
                  "btn h-auto py-5 px-5 justify-start text-left text-lg shadow-md border-2 border-base-content/60 whitespace-normal",
                  @form[:correct_index].value == idx && "btn-primary",
                  @form[:correct_index].value != idx && "bg-base-200 border-base-300"
                ]}>
                  <span class="font-mono font-bold mr-3 shrink-0">
                    {String.capitalize(PubQuizzerWeb.CoreComponents.letter_for_index(idx))}.
                  </span>
                  <span class="font-semibold">{option}</span>
                  <%= if @form[:correct_index].value == idx do %>
                    <.icon name="hero-check-circle" class="size-6 shrink-0 ml-auto" />
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <%!-- Form only --%>
        <div class="card bg-base-200 border border-base-300">
          <div class="card-body">
            <.form
              for={@form}
              id="question-form"
              phx-change="validate"
              phx-submit="save"
              class="space-y-4"
            >
              <.input
                field={@form[:prompt]}
                type="textarea"
                label="Frage"
                placeholder="Wie lautet die Frage?"
                rows="3"
              />

              <fieldset class="fieldset">
                <legend class="label mb-2">
                  Optionen (richtige Antwort markieren, per Drag & Drop sortieren)
                </legend>

                <div id="question-options" class="space-y-2" phx-hook="OptionSorter">
                  <%= for i <- 0..3 do %>
                    <div
                      data-index={i}
                      class={[
                        "flex items-start gap-1 opt-row rounded-lg border-2 p-1 transition-colors",
                        @form[:correct_index].value == i && "border-primary bg-primary/5",
                        @form[:correct_index].value != i && "border-base-300 bg-base-100"
                      ]}
                    >
                      <div class="flex flex-col items-center gap-0.5 px-2 py-3 text-base-content/30 cursor-grab select-none drag-handle">
                        <span class="leading-none">⠿</span>
                      </div>
                      <input
                        type="radio"
                        name="question[correct_index]"
                        value={i}
                        id={"correct-#{i}"}
                        checked={@form[:correct_index].value == i}
                        class="radio radio-primary radio-sm mt-2.5"
                      />
                      <div class="font-mono font-bold text-sm text-base-content/50 w-6 pt-2.5 shrink-0 text-center">
                        {String.capitalize(PubQuizzerWeb.CoreComponents.letter_for_index(i))}.
                      </div>
                      <textarea
                        name={"question[options][#{i}]"}
                        id={"question_options_#{i}"}
                        class="textarea textarea-bordered textarea-sm w-full leading-tight bg-base-100"
                        rows="1"
                      ><%= Phoenix.HTML.Form.input_value(@form, :options) |> Enum.at(i) || "" %></textarea>
                    </div>
                  <% end %>
                </div>
              </fieldset>

              <div
                id="image-upload-zone"
                phx-hook="ImagePreview"
                phx-drop-target={@uploads.image.ref}
                class="flex flex-col gap-2 p-4 border-2 border-dashed border-base-300 bg-base-100 rounded-box"
              >
                <label class="text-sm font-semibold">Bild (optional)</label>
                <%= if @question.image do %>
                  <div class="mb-2">
                    <img src={@question.image} alt="Aktuelles Bild" class="max-h-32 rounded-lg" />
                    <p class="text-xs text-base-content/70 mt-1">Aktuelles Bild</p>
                  </div>
                <% end %>
                <.live_file_input
                  upload={@uploads.image}
                  class="file-input file-input-bordered w-full"
                />
                <p class="text-xs text-base-content/70">
                  Neues Bild hochladen (ersetzt das alte)
                </p>
                <div
                  :for={entry <- @uploads.image.entries}
                  class="flex items-center gap-2 text-sm"
                >
                  <span>{entry.client_name}</span>
                  <button
                    type="button"
                    phx-click="cancel_upload"
                    phx-value-ref={entry.ref}
                    class="btn btn-xs"
                  >
                    Entfernen
                  </button>
                </div>
                <%= if @image_preview_url do %>
                  <div class="relative w-fit">
                    <img src={@image_preview_url} class="max-h-32 rounded-lg" />
                  </div>
                <% end %>
              </div>
            </.form>
          </div>
        </div>
      <% end %>
    </div>

    <%!-- Sidebar: edit history as a card (only when there's space) --%>
    <aside class="hidden xl:block">
      <div class="card bg-base-200 border border-base-300 h-full">
        <div class="card-body p-4 gap-3">
          <h3 class="text-sm font-semibold text-base-content/80">Bearbeitungsverlauf</h3>
          <div class="flex flex-col gap-2">
            <%= for {version, diffs} <- @versions do %>
              <div class="rounded-lg border border-base-300 bg-base-100 px-3 py-2">
                <div class="flex items-center gap-2">
                  <div class="avatar avatar-placeholder">
                    <div class="bg-primary text-primary-content rounded-full w-7">
                      <span class="text-xs font-semibold">
                        {String.at((version.user && version.user.name) || "?", 0)}
                      </span>
                    </div>
                  </div>
                  <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm block truncate">
                      {(version.user && version.user.name) || "Unbekannt"}
                    </span>
                    <span class="text-xs text-base-content/70">
                      {Calendar.strftime(version.inserted_at, "%d.%m.%y %H:%M")}
                    </span>
                  </div>
                </div>
                <%= if diffs != [] do %>
                  <ul class="mt-2 space-y-1 text-xs text-base-content/80 border-t border-base-300 pt-2">
                    <%= for diff <- diffs do %>
                      <li class="flex items-start gap-1">
                        <.icon
                          name="hero-pencil"
                          class="size-3 mt-0.5 shrink-0 text-base-content/60"
                        />
                        <%= case diff.field do %>
                          <% :prompt -> %>
                            <span class="font-semibold">Frage geändert</span>
                          <% :options -> %>
                            <span class="font-semibold">Optionen geändert</span>
                          <% :correct_index -> %>
                            <span class="font-semibold">Antwort:</span>
                            {String.capitalize(
                              PubQuizzerWeb.CoreComponents.letter_for_index(diff.old || 0)
                            )} → {String.capitalize(
                              PubQuizzerWeb.CoreComponents.letter_for_index(diff.new || 0)
                            )}
                          <% :image -> %>
                            <%= cond do %>
                              <% is_nil(diff.old) and not is_nil(diff.new) -> %>
                                <span class="font-semibold">Bild hinzugefügt</span>
                              <% not is_nil(diff.old) and is_nil(diff.new) -> %>
                                <span class="font-semibold">Bild entfernt</span>
                              <% true -> %>
                                <span class="font-semibold">Bild geändert</span>
                            <% end %>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            <% end %>
            <%= if @versions == [] do %>
              <p class="text-sm text-base-content/70 italic">Noch keine Versionen.</p>
            <% end %>
          </div>
        </div>
      </div>
    </aside>
  </div>
</Layouts.app>
