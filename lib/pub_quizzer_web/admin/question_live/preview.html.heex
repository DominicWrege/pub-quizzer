<dialog
  id="question-preview-modal"
  phx-hook="Dialog"
  data-cancel-event="close_preview"
  class="m-auto rounded-box bg-base-100 p-0 shadow-xl max-w-6xl w-[calc(100%-2rem)] sm:w-full"
>
  <div class="flex items-center justify-between p-5 border-b border-base-300">
    <div>
      <h3 class="text-lg font-bold">Vorschau</h3>
      <p class="text-xs text-base-content/60">So wird die Frage auf dem Beamer angezeigt.</p>
    </div>
    <button
      type="button"
      phx-click="close_preview"
      aria-label="Schließen"
      class="btn btn-circle btn-ghost btn-sm shrink-0"
    >
      <.icon name="hero-x-mark" class="size-5" />
    </button>
  </div>

  <div class="p-4 sm:p-6 max-h-[80vh] overflow-y-auto">
    <% prompt_text = @form[:prompt].value || "" %>
    <% form_options = Phoenix.HTML.Form.input_value(@form, :options) || [] %>
    <% main_images = ((@question && @question.images) || []) ++ Map.values(@preview_uploads) %>

    <% options =
      form_options
      |> Enum.with_index()
      |> Enum.map(fn {opt, idx} ->
        case Map.get(@option_image_previews, idx) do
          nil -> opt
          url -> Map.put(opt || %{}, "image", url)
        end
      end) %>

    <% preview_question = %{
      prompt: prompt_text,
      options: options,
      images: main_images,
      layout: @form[:layout].value || "classic",
      image_position: @form[:image_position].value || "left"
    } %>

    <.question_slide question={preview_question} />
  </div>
</dialog>
