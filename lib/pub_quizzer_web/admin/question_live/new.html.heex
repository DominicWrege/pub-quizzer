<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
  main_class="px-2 sm:px-6 lg:px-8 pb-4 sm:pb-10 max-w-full"
>
  <.header inline_actions class="max-sm:mb-2 lg:!mb-0">
    <:back>
      <.back_link navigate={~p"/admin/topics/#{@topic.id}/questions"} />
    </:back>
    {@topic.name}
    <:actions>
      <button
        type="button"
        phx-click="toggle_preview"
        class="btn btn-soft btn-sm gap-1 hidden sm:inline-flex"
      >
        <.icon name="hero-eye" class="size-4" /> Vorschau
      </button>
      <button
        type="submit"
        form="question-form"
        class="btn btn-primary btn-sm gap-1"
      >
        <span class="loading loading-spinner loading-xs hidden [.phx-submit-loading_&]:inline-block"></span>
        <.icon name="hero-check-circle" class="size-4 [.phx-submit-loading_&]:hidden" /> Speichern
      </button>
    </:actions>
  </.header>

  <.form
    for={@form}
    id="question-form"
    phx-change="validate"
    phx-submit="save"
    class="bg-base-200 rounded-2xl p-1.5 sm:p-6 space-y-5 border border-base-300"
  >
    <input type="hidden" name="question[correct_index]" value={@form[:correct_index].value} />

    <.status_card form={@form} />
    <.form_errors form={@form} submitted={@form_submitted} />
    <.prompt_card form={@form} uploads={@uploads} question={@question} />
    <.option_rows
      form={@form}
      uploads={@uploads}
      option_image_previews={@option_image_previews}
    />
  </.form>

  <%= if @show_preview do %>
    {preview(assigns)}
  <% end %>

  <.image_lightbox url={@viewing_image} />
</Layouts.app>
