<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
  main_class="px-2 sm:px-6 lg:px-8 pb-4 sm:pb-10 max-w-full"
>
  <.header inline_actions class="max-sm:mb-2">
    <:back>
      <.link navigate={~p"/admin/topics/#{@topic.id}/questions"} class="btn btn-sm btn-soft">
        ←<span class="hidden sm:inline"> Zurück</span>
      </.link>
    </:back>
    Neue Frage
    <:subtitle>{@topic.name}</:subtitle>
    <:actions>
      <button
        type="button"
        phx-click="toggle_preview"
        class="btn btn-soft btn-sm gap-1 hidden sm:inline-flex"
      >
        <.icon name="hero-eye" class="size-4" /> Vorschau
      </button>
      <button
        type="submit"
        form="question-form"
        class="btn btn-primary btn-sm gap-1"
      >
        <.icon name="hero-check-circle" class="size-4" /> Speichern
      </button>
    </:actions>
  </.header>

  <.form
    for={@form}
    id="question-form"
    phx-change="validate"
    phx-submit="save"
    class="bg-base-200 rounded-2xl p-1.5 sm:p-6 space-y-5 border border-base-300"
  >
    <input type="hidden" name="question[correct_index]" value={@form[:correct_index].value} />

    <div class="flex items-center justify-between bg-base-100 border border-base-300 rounded-xl px-4 py-3">
      <div>
        <div class="text-sm font-medium">Veröffentlicht</div>
        <div class="text-xs text-base-content/60 hidden sm:block">
          Entwurfs-Fragen erscheinen nicht im Live-Quiz
        </div>
      </div>
      <label class="cursor-pointer">
        <input type="hidden" name="question[published]" value="false" />
        <input
          type="checkbox"
          name="question[published]"
          value="true"
          checked={@form[:status].value == "published"}
          class="toggle toggle-success"
        />
      </label>
    </div>

    <.form_errors form={@form} submitted={@form_submitted} />

    <%!-- Prompt card --%>
    <div class="card sm:bg-base-100 sm:border sm:border-base-300 sm:shadow-md">
      <div class="card-body p-0 sm:p-5 gap-3 sm:gap-4">
        <div class="flex items-center justify-between px-3 sm:px-0">
          <span class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
            Frage
          </span>
          <%= if @form[:correct_index].value != nil do %>
            <span class="text-xs text-base-content/50">
              Richtige Antwort:
              <span class="font-mono font-bold text-success">
                {String.capitalize(letter_for_index(@form[:correct_index].value))}
              </span>
            </span>
          <% end %>
        </div>
        <textarea
          name="question[prompt]"
          id="question_prompt"
          phx-hook="AutoResize"
          class="w-full text-2xl font-semibold leading-relaxed bg-base-100 border-2 border-base-300 rounded-lg outline-none resize-none placeholder:text-base-content/30 focus:outline-none px-3 py-2"
          placeholder="Wie lautet die Frage?"
          rows="2"
        ><%= @form[:prompt].value || "" %></textarea>

        <div
          id="image-upload-zone"
          phx-hook="ImagePreview"
          phx-drop-target={@uploads.image.ref}
          class={[
            "hidden sm:block rounded-lg border-2 border-dashed transition-colors",
            @uploads.image.entries != [] && "border-primary bg-primary/5",
            @uploads.image.entries == [] && "border-base-300 hover:border-base-content/30"
          ]}
        >
          <div class="p-2 sm:p-3">
            <%= cond do %>
              <% @image_preview_url -> %>
                <div class="relative">
                  <img
                    src={@image_preview_url}
                    data-main-image-preview
                    class="rounded-lg max-h-36 sm:max-h-56 w-full object-contain"
                  />
                </div>
              <% true -> %>
                <div class="flex flex-row sm:flex-col items-center justify-center gap-1.5 sm:gap-1 py-2 sm:py-6 text-base-content/40">
                  <.icon name="hero-photo" class="size-5 sm:size-8" />
                  <span class="text-xs">Kein Bild ausgewählt</span>
                </div>
            <% end %>
          </div>
          <label class="flex items-center justify-center gap-2 p-3 cursor-pointer text-xs text-base-content/70 hover:text-base-content hover:bg-base-300/50 transition-colors rounded-b-lg border-t border-base-300">
            <.icon name="hero-photo" class="size-4" />
            <span>Bild auswählen</span>
            <.live_file_input upload={@uploads.image} class="sr-only" />
          </label>
        </div>
      </div>
    </div>

    <%!-- Options --%>
    <div>
      <div class="flex items-center justify-between mb-2 px-3 sm:px-0">
        <span class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
          Antwortoptionen
        </span>
        <span class="text-xs text-base-content/50">
          Klick zum Auswählen<span class="hidden sm:inline"> · Ziehen zum Sortieren</span>
        </span>
      </div>

      <div
        id="question-options"
        class="space-y-2"
        phx-hook="OptionSorter"
        data-correct-index={@form[:correct_index].value}
      >
        <%= for i <- 0..3 do %>
          <% opt_val = Phoenix.HTML.Form.input_value(@form, :options) |> Enum.at(i, %{}) %>
          <% opt_text = (is_map(opt_val) && Map.get(opt_val, "text")) || "" %>
          <% is_correct = @form[:correct_index].value == i %>
          <div
            data-index={i}
            phx-click="select_correct"
            phx-value-index={i}
            class={[
              "opt-row group relative rounded-lg sm:rounded-xl p-1.5 sm:p-3 transition-all cursor-pointer sm:border-2 sm:shadow-md",
              is_correct && "bg-success/10 sm:border-success sm:shadow-lg",
              !is_correct &&
                "bg-base-100 sm:border-base-300 sm:hover:border-base-content/40 sm:hover:shadow-lg"
            ]}
          >
            <div class="flex items-start gap-2">
              <div class="hidden sm:flex flex-col items-center gap-0.5 pt-2 text-base-content/30 cursor-grab select-none drag-handle hover:text-base-content/60">
                <span class="leading-none text-lg">⠿</span>
              </div>

              <div class={[
                "font-mono font-bold text-lg sm:text-xl w-6 sm:w-7 pt-2 shrink-0 text-center",
                is_correct && "text-success",
                !is_correct && "text-base-content/50"
              ]}>
                {String.capitalize(letter_for_index(i))}
              </div>

              <textarea
                name={"question[options][#{i}]"}
                id={"question_options_#{i}"}
                data-option-text
                phx-hook="AutoResize"
                onclick="event.stopPropagation()"
                class="flex-1 min-w-0 bg-base-100 border-2 border-base-300 rounded-lg outline-none resize-none text-lg leading-relaxed placeholder:text-base-content/30 focus:outline-none px-2 py-1.5 min-h-[3.75rem] whitespace-pre-wrap"
                placeholder={"Option #{String.capitalize(letter_for_index(i))}"}
                rows="2"
              ><%= opt_text %></textarea>

              <div class={[
                "hidden sm:block pt-2 shrink-0 transition-opacity",
                is_correct && "opacity-100",
                !is_correct && "opacity-0 group-hover:opacity-30"
              ]}>
                <.icon
                  name="hero-check-circle"
                  class={[
                    "size-5",
                    is_correct && "text-success",
                    !is_correct && "text-base-content/40"
                  ]}
                />
              </div>
            </div>

            <div
              id={"option-image-zone-#{i}"}
              data-option-index={i}
              phx-hook="OptionImagePreview"
              phx-drop-target={@option_uploads[i].ref}
              class="hidden sm:block mt-2 ml-8 sm:ml-16"
            >
              <%= cond do %>
                <% preview = @option_image_previews[i] -> %>
                  <%!-- Mobile: icon button --%>
                  <button
                    type="button"
                    phx-click="view_image"
                    phx-value-url={preview}
                    class="sm:hidden btn btn-xs btn-ghost gap-1"
                  >
                    <.icon name="hero-photo" class="size-4" />
                    <span class="text-xs">Bild</span>
                  </button>
                  <%!-- Desktop: inline preview --%>
                  <div class="hidden sm:block relative inline-block pt-4">
                    <img src={preview} class="h-40 max-w-full rounded border border-base-300" />
                    <button
                      type="button"
                      phx-click="cancel_option_upload"
                      phx-value-index={i}
                      class="btn btn-xs btn-circle absolute top-2 -right-2"
                    >×</button>
                  </div>
                <% true -> %>
                  <label class="inline-flex items-center gap-1.5 px-6 py-2 rounded-md border border-base-300 text-xs text-base-content/70 bg-base-200 hover:bg-base-300 hover:border-base-content/40 cursor-pointer transition-colors">
                    <.icon name="hero-photo" class="size-3.5" />
                    <span>Bild</span>
                    <.live_file_input
                      upload={@option_uploads[i]}
                      class="sr-only"
                    />
                  </label>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </.form>

  <%= if @show_preview do %>
    {preview(assigns)}
  <% end %>

  <.image_lightbox url={@viewing_image} />
</Layouts.app>
