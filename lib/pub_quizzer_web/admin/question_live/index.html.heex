<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl min-[1650px]:max-w-[1700px]"
>
  <div
    data-sticky-bar
    class="sticky top-0 z-10 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 bg-base-100 border-b border-transparent transition-[box-shadow,border-color] duration-200 pt-2 pb-2 lg:pt-2 lg:pb-3"
  >
    <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0">
        <div class="flex items-center gap-2 sm:gap-3">
          <.link
            navigate={~p"/admin/topics"}
            class="btn btn-xs btn-soft gap-1"
            aria-label="Zurück zu Themen"
          >
            <.icon name="hero-arrow-left" class="size-3.5" />
            <span class="hidden sm:inline">Zurück</span>
          </.link>
          <h1 class="min-w-0 truncate text-xl sm:text-2xl font-bold leading-tight">
            {@topic.name}
          </h1>
          <span class="badge badge-ghost badge-sm font-mono">{@questions_count}</span>
          <button
            type="button"
            phx-click="start_edit_topic"
            aria-label="Thema bearbeiten"
            class="btn btn-xs btn-soft btn-square"
          >
            <.icon name="hero-pencil" class="size-3.5" />
          </button>
        </div>
      </div>
      <div class="flex items-center gap-2 sm:gap-3 w-full lg:w-auto">
        <form id="search-form" phx-change="search" class="group relative flex-1 lg:flex-none">
          <.icon
            name="hero-magnifying-glass"
            class="pointer-events-none absolute z-10 left-2.5 top-1/2 size-4 -translate-y-1/2 text-base-content/50 transition-colors duration-150 group-focus-within:text-base-content/70"
          />
          <input
            name="search"
            type="text"
            value={@search}
            placeholder="Suchen..."
            class="input input-sm peer w-full pl-8 pr-8 lg:w-56"
          />
          <button
            type="button"
            data-clear-input
            aria-label="Suche leeren"
            class="absolute z-10 right-1.5 top-1/2 hidden size-6 -translate-y-1/2 items-center justify-center rounded-full text-base-content/50 transition duration-150 hover:bg-base-300 hover:text-base-content active:scale-90 peer-[:not(:placeholder-shown)]:flex"
          >
            <.icon name="hero-x-mark" class="size-3.5" />
          </button>
        </form>
        <.link
          navigate={~p"/admin/topics/#{@topic.id}/questions/new"}
          class="btn btn-primary btn-sm hidden lg:inline-flex"
        >
          <.icon name="hero-plus" class="size-4" /> Neue Frage
        </.link>
      </div>
    </div>
  </div>

  <%!-- Unified question list — cards at every breakpoint. This is the single
      phx-update="stream" container: child ids equal the stream item ids, so
      search resets and deletes prune correctly. --%>
  <div
    id="questions"
    phx-update="stream"
    phx-hook="QuestionSorter"
    class="grid grid-cols-1 md:grid-cols-2 min-[1650px]:grid-cols-3 gap-3 items-start pb-24 lg:pb-8"
  >
    <div
      :for={{id, q} <- @streams.questions}
      id={id}
      class="q-card flex flex-col bg-base-200 border-2 border-base-300 rounded-xl px-4 pt-4 pb-3 transition-shadow hover:shadow-md"
    >
      <%!-- Read-only status + image indicator --%>
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <span class={[
          "badge badge-soft badge-sm gap-1.5",
          if(q.status == "published", do: "badge-success", else: "badge-warning")
        ]}>
          <span class={[
            "size-1.5 rounded-full",
            if(q.status == "published", do: "bg-success", else: "bg-warning")
          ]}></span>
          {if q.status == "published", do: "Live", else: "Entwurf"}
        </span>
        <%= if q.image do %>
          <span class="badge badge-ghost badge-xs gap-1">
            <.icon name="hero-photo" class="size-3" /> Bild
          </span>
        <% end %>
      </div>

      <div class="font-medium break-words">
        <.multiline_text text={q.prompt} />
      </div>

      <div class="flex items-center gap-2 mt-2 text-xs text-base-content/50">
        <span>{Calendar.strftime(q.updated_at, "%d.%m.%y")}</span>
        <%= if q.last_editor_name do %>
          <span class="text-base-content/30">·</span>
          <span>{q.last_editor_name}</span>
        <% end %>
      </div>

      <div class="flex items-center gap-2 mt-2 pt-2 border-t border-base-300">
        <%= if @search == "" do %>
          <div class="flex items-center gap-0.5">
            <button
              type="button"
              phx-click="move_up"
              phx-value-id={q.id}
              disabled={q.id == @first_question_id}
              aria-label="Nach oben verschieben"
              class="btn btn-xs btn-soft btn-square"
            >
              <.icon name="hero-arrow-up" class="size-3.5" />
            </button>
            <button
              type="button"
              phx-click="move_down"
              phx-value-id={q.id}
              disabled={q.id == @last_question_id}
              aria-label="Nach unten verschieben"
              class="btn btn-xs btn-soft btn-square"
            >
              <.icon name="hero-arrow-down" class="size-3.5" />
            </button>
            <div
              aria-hidden="true"
              title="Ziehen zum Sortieren"
              class="hidden lg:flex flex-col items-center justify-center px-1 text-base-content/30 cursor-grab select-none drag-handle hover:text-base-content/60"
            >
              <span class="leading-none text-lg">⠿</span>
            </div>
          </div>
        <% end %>
        <div class="flex-1"></div>
        <.link
          navigate={~p"/admin/topics/#{@topic.id}/questions/#{q}/edit"}
          aria-label="Bearbeiten"
          class="btn btn-primary btn-sm gap-1.5"
        >
          <.icon name="hero-pencil" class="size-4" />
          <span class="hidden sm:inline">Bearbeiten</span>
        </.link>
        <button
          phx-click="ask_delete"
          phx-value-id={q.id}
          aria-label="Löschen"
          class="btn btn-sm btn-danger-soft gap-1.5"
        >
          <.icon name="hero-trash" class="size-4" />
          <span class="hidden sm:inline">Löschen</span>
        </button>
      </div>
    </div>
  </div>

  <%!-- Mobile floating "Neue Frage" button --%>
  <.link
    navigate={~p"/admin/topics/#{@topic.id}/questions/new"}
    aria-label="Neue Frage"
    class="btn btn-primary border-none fixed bottom-[calc(env(safe-area-inset-bottom)+0.5rem)] right-[calc(env(safe-area-inset-right)+1.25rem)] z-40 rounded-full pl-4 pr-5 gap-2 shadow-lg shadow-primary/40 active:scale-95 lg:hidden"
  >
    <.icon name="hero-plus" class="size-5" />
    <span class="font-semibold">Neue Frage</span>
  </.link>

  <.confirm_modal
    id="delete-question-modal"
    show={@confirm_action == :delete_question}
    title="Frage löschen?"
    message="Diese Frage löschen?"
    confirm_label="Löschen"
    confirm_event="confirm_delete"
    cancel_event="cancel_confirm"
  />

  <%= if @editing_topic do %>
    <dialog
      id="topic-form-modal"
      phx-hook="Dialog"
      data-cancel-event="cancel_edit_topic"
      class="m-auto rounded-box bg-base-100 p-4 sm:p-6 shadow-xl max-w-lg w-[calc(100%-2rem)] sm:w-full max-h-[90vh] overflow-y-auto"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <h3 class="text-lg font-bold">Thema bearbeiten</h3>
        <button
          type="button"
          phx-click="cancel_edit_topic"
          aria-label="Schließen"
          class="btn btn-circle btn-ghost btn-sm shrink-0"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>
      <.form for={@topic_form} id="topic-form" phx-submit="save_topic">
        <.input field={@topic_form[:name]} type="text" label="Name" />
        <.input
          field={@topic_form[:description]}
          type="text"
          label="Beschreibung"
          placeholder="Optional"
        />
        <div class="mt-4">
          <label class="flex items-center cursor-pointer gap-2">
            <span class="text-sm font-medium">Aktiv</span>
            <input type="hidden" name="topic[enabled]" value="false" />
            <input
              type="checkbox"
              name="topic[enabled]"
              value="true"
              class="toggle toggle-primary"
              checked={@topic_form[:enabled].value}
            />
          </label>
        </div>
        <div class="flex justify-between items-center mt-6">
          <button type="button" phx-click="ask_delete_topic" class="btn btn-sm btn-danger-soft">
            <.icon name="hero-trash" class="size-4" /> Löschen
          </button>
          <button type="submit" class="btn btn-primary btn-sm">Speichern</button>
        </div>
      </.form>
    </dialog>
  <% end %>

  <.confirm_modal
    id="delete-topic-modal"
    show={@confirm_action == :delete_topic}
    title="Thema löschen?"
    message="Thema und alle Fragen löschen?"
    confirm_label="Löschen"
    confirm_event="confirm_delete_topic"
    cancel_event="cancel_confirm"
  />
</Layouts.app>
