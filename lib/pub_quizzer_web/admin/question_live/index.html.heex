<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
>
  <div class="pt-4 lg:pt-0">
    <.header>
      <:back>
        <.link navigate={~p"/admin/topics"} class="btn btn-sm btn-soft gap-0">
          <span class="sm:hidden">←</span>
          <span class="hidden sm:inline">← Zurück zu Themen</span>
        </.link>
      </:back>
      Fragen
      <:subtitle>{@topic.name}</:subtitle>
      <:actions>
        <form id="search-form" phx-change="search" class="contents">
          <input
            name="search"
            type="text"
            value={@search}
            placeholder="Suchen..."
            class="input input-sm w-full sm:w-auto"
          />
        </form>
        <.link
          navigate={~p"/admin/topics/#{@topic.id}/questions/new"}
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-plus" class="size-4" /> Neue Frage
        </.link>
      </:actions>
    </.header>
  </div>

  <%!-- Mobile: cards --%>
  <div id="questions-cards" class="space-y-3 lg:hidden">
    <div
      :for={{id, q} <- @streams.questions}
      id={"card-#{id}"}
      class="bg-base-200 border-2 border-base-300 rounded-xl px-4 pt-4 pb-3"
    >
      <div class="text-xs text-base-content/60 mb-1">#{q.position + 1}</div>
      <div class="font-medium line-clamp-2 break-words">{q.prompt}</div>
      <div class="flex items-center gap-3 mt-2 text-xs text-base-content/50">
        <span>{String.capitalize(letter_for_index(q.correct_index))}</span>
        <span>{Calendar.strftime(q.updated_at, "%d.%m.%y")}</span>
        <%= if q.last_editor_name do %>
          <span>{q.last_editor_name}</span>
        <% end %>
      </div>
      <div class="flex items-center gap-2 mt-2 pt-2 border-t border-base-300">
        <input
          type="checkbox"
          class="toggle toggle-success toggle-sm"
          checked={q.status == "published"}
          phx-click="toggle_status"
          phx-value-id={q.id}
          aria-label={
            if q.status == "draft",
              do: "Frage veröffentlichen",
              else: "Frage auf Entwurf setzen"
          }
        />
        <span class={[
          "text-xs font-medium",
          if(q.status == "published", do: "text-success", else: "text-warning")
        ]}>
          {if q.status == "published", do: "Live", else: "Entwurf"}
        </span>
        <div class="flex-1"></div>
        <.link
          navigate={~p"/admin/topics/#{@topic.id}/questions/#{q}/edit"}
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-pencil" class="size-4" />
        </.link>
        <button
          phx-click="ask_delete"
          phx-value-id={q.id}
          class="btn btn-sm btn-danger-soft"
        >
          <.icon name="hero-trash" class="size-4" />
        </button>
      </div>
    </div>
  </div>

  <%!-- Desktop: table --%>
  <div class="overflow-x-auto rounded-lg border-2 border-base-300 hidden lg:block">
    <.table
      id="questions"
      rows={@streams.questions}
      row_id={fn {id, _} -> id end}
    >
      <:col :let={{_id, q}} label="#"><span class="opacity-60">{q.position + 1}</span></:col>
      <:col :let={{_id, q}} label="Frage">{q.prompt}</:col>
      <:col :let={{_id, q}} label="Status">
        <div class="inline-flex items-center gap-2.5 w-28">
          <input
            type="checkbox"
            class="toggle toggle-success toggle-sm"
            checked={q.status == "published"}
            phx-click="toggle_status"
            phx-value-id={q.id}
            aria-label={
              if q.status == "draft",
                do: "Frage veröffentlichen",
                else: "Frage auf Entwurf setzen"
            }
          />
          <span class={[
            "text-sm font-medium whitespace-nowrap",
            if(q.status == "published", do: "text-success", else: "text-warning")
          ]}>
            {if q.status == "published", do: "Live", else: "Entwurf"}
          </span>
        </div>
      </:col>
      <:col :let={{_id, q}} label="Korrekt">
        <span class="whitespace-nowrap">{String.capitalize(letter_for_index(q.correct_index))}</span>
      </:col>
      <:col :let={{_id, q}} label="Zuletzt">
        <div class="flex items-center gap-1.5 whitespace-nowrap text-sm">
          <span class="text-base-content/70">{Calendar.strftime(q.updated_at, "%d.%m.%y %H:%M")}</span>
          <%= if q.last_editor_name do %>
            <span class="text-base-content/40">·</span>
            <span class="text-base-content/50">{q.last_editor_name}</span>
          <% end %>
          <%= if q.image do %>
            <span class="badge badge-ghost badge-xs gap-1">
              <.icon name="hero-eye" class="size-3" /> Bild
            </span>
          <% end %>
        </div>
      </:col>
      <:action :let={{_id, q}}>
        <.link
          navigate={~p"/admin/topics/#{@topic.id}/questions/#{q}/edit"}
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-pencil" class="size-4" /> Bearbeiten
        </.link>
        <button
          phx-click="ask_delete"
          phx-value-id={q.id}
          class="btn btn-sm btn-danger-soft"
        >
          <.icon name="hero-trash" class="size-4" /> Löschen
        </button>
      </:action>
    </.table>
  </div>

  <.confirm_modal
    id="delete-question-modal"
    show={@confirm_action == :delete_question}
    title="Frage löschen?"
    message="Diese Frage löschen?"
    confirm_label="Löschen"
    confirm_event="confirm_delete"
    cancel_event="cancel_confirm"
  />
</Layouts.app>
