<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
>
  <div
    data-sticky-bar
    class="sticky top-0 z-10 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 bg-base-100 border-b border-transparent transition-[box-shadow,border-color] duration-200 pt-3 pb-2 lg:pt-2 lg:pb-3"
  >
    <div class="flex flex-col gap-2 lg:gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0">
        <div class="flex items-center gap-2 sm:gap-3">
          <.link
            navigate={~p"/admin/topics"}
            class="btn btn-xs btn-soft gap-1"
            aria-label="Zurück zu Themen"
          >
            <.icon name="hero-arrow-left" class="size-3.5" />
            <span class="hidden sm:inline">Zurück</span>
          </.link>
          <h1 class="min-w-0 truncate text-xl sm:text-2xl font-bold leading-tight">
            {@topic.name}
          </h1>
          <span class="badge badge-ghost badge-sm font-mono">{@questions_count}</span>
        </div>
      </div>
      <div class="flex items-center gap-2 sm:gap-3 w-full lg:w-auto">
        <form id="search-form" phx-change="search" class="group relative flex-1 lg:flex-none">
          <.icon
            name="hero-magnifying-glass"
            class="pointer-events-none absolute z-10 left-2.5 top-1/2 size-4 -translate-y-1/2 text-base-content/50 transition-colors duration-150 group-focus-within:text-base-content/70"
          />
          <input
            name="search"
            type="text"
            value={@search}
            placeholder="Suchen..."
            class="input input-sm peer w-full pl-8 pr-8 lg:w-56"
          />
          <button
            type="button"
            data-clear-input
            aria-label="Suche leeren"
            class="absolute z-10 right-1.5 top-1/2 hidden size-6 -translate-y-1/2 items-center justify-center rounded-full text-base-content/50 transition duration-150 hover:bg-base-300 hover:text-base-content active:scale-90 peer-[:not(:placeholder-shown)]:flex"
          >
            <.icon name="hero-x-mark" class="size-3.5" />
          </button>
        </form>
        <.link
          navigate={~p"/admin/topics/#{@topic.id}/questions/new"}
          class="btn btn-primary btn-sm hidden lg:inline-flex"
        >
          <.icon name="hero-plus" class="size-4" /> Neue Frage
        </.link>
      </div>
    </div>
  </div>

  <%!-- Mobile: cards. Plain keyed list (not a second phx-update="stream"
      container): stream DOM ids must equal the stream item ids, which the
      desktop table already uses — prefixed card ids would never match the
      client-side stream prune/reset, leaving stale cards after filtering. --%>
  <div id="questions-cards" class="space-y-3 pb-24 lg:pb-0 lg:hidden">
    <div
      :for={{id, q} <- @streams.questions}
      id={"card-#{id}"}
      class="bg-base-200 border-2 border-base-300 rounded-xl px-4 pt-4 pb-3"
    >
      <div class="text-xs text-base-content/60 mb-1">#{q.position + 1}</div>
      <div class="font-medium line-clamp-2 break-words whitespace-pre-wrap">{q.prompt}</div>
      <div class="flex items-center gap-3 mt-2 text-xs text-base-content/50">
        <span>{String.capitalize(letter_for_index(q.correct_index))}</span>
        <span>{Calendar.strftime(q.updated_at, "%d.%m.%y")}</span>
        <%= if q.last_editor_name do %>
          <span>{q.last_editor_name}</span>
        <% end %>
      </div>
      <div class="flex items-center gap-2 mt-2 pt-2 border-t border-base-300">
        <input
          type="checkbox"
          class="toggle toggle-success toggle-sm"
          checked={q.status == "published"}
          phx-click="toggle_status"
          phx-value-id={q.id}
          aria-label={
            if q.status == "draft",
              do: "Frage veröffentlichen",
              else: "Frage auf Entwurf setzen"
          }
        />
        <span class={[
          "text-xs font-medium",
          if(q.status == "published", do: "text-success", else: "text-warning")
        ]}>
          {if q.status == "published", do: "Live", else: "Entwurf"}
        </span>
        <div class="flex-1"></div>
        <.link
          navigate={~p"/admin/topics/#{@topic.id}/questions/#{q}/edit"}
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-pencil" class="size-4" />
        </.link>
        <button
          phx-click="ask_delete"
          phx-value-id={q.id}
          class="btn btn-sm btn-danger-soft"
        >
          <.icon name="hero-trash" class="size-4" />
        </button>
      </div>
    </div>
  </div>

  <%!-- Desktop: table --%>
  <div class="overflow-x-auto rounded-lg border-2 border-base-300 hidden lg:block">
    <.table
      id="questions"
      rows={@streams.questions}
      row_id={fn {id, _} -> id end}
    >
      <:col :let={{_id, q}} label="#"><span class="opacity-60">{q.position + 1}</span></:col>
      <:col :let={{_id, q}} label="Frage">
        <span class="whitespace-pre-wrap">{q.prompt}</span>
      </:col>
      <:col :let={{_id, q}} label="Status">
        <div class="inline-flex items-center gap-2.5 w-28">
          <input
            type="checkbox"
            class="toggle toggle-success toggle-sm"
            checked={q.status == "published"}
            phx-click="toggle_status"
            phx-value-id={q.id}
            aria-label={
              if q.status == "draft",
                do: "Frage veröffentlichen",
                else: "Frage auf Entwurf setzen"
            }
          />
          <span class={[
            "text-sm font-medium whitespace-nowrap",
            if(q.status == "published", do: "text-success", else: "text-warning")
          ]}>
            {if q.status == "published", do: "Live", else: "Entwurf"}
          </span>
        </div>
      </:col>
      <:col :let={{_id, q}} label="Korrekt">
        <span class="whitespace-nowrap">{String.capitalize(letter_for_index(q.correct_index))}</span>
      </:col>
      <:col :let={{_id, q}} label="Zuletzt">
        <div class="flex items-center gap-1.5 whitespace-nowrap text-sm">
          <span class="text-base-content/70">{Calendar.strftime(q.updated_at, "%d.%m.%y %H:%M")}</span>
          <%= if q.last_editor_name do %>
            <span class="text-base-content/40">·</span>
            <span class="text-base-content/50">{q.last_editor_name}</span>
          <% end %>
          <%= if q.image do %>
            <span class="badge badge-ghost badge-xs gap-1">
              <.icon name="hero-eye" class="size-3" /> Bild
            </span>
          <% end %>
        </div>
      </:col>
      <:action :let={{_id, q}}>
        <.link
          navigate={~p"/admin/topics/#{@topic.id}/questions/#{q}/edit"}
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-pencil" class="size-4" /> Bearbeiten
        </.link>
        <button
          phx-click="ask_delete"
          phx-value-id={q.id}
          class="btn btn-sm btn-danger-soft"
        >
          <.icon name="hero-trash" class="size-4" /> Löschen
        </button>
      </:action>
    </.table>
  </div>

  <%!-- Mobile floating "Neue Frage" button --%>
  <.link
    navigate={~p"/admin/topics/#{@topic.id}/questions/new"}
    aria-label="Neue Frage"
    class="btn btn-primary border-none fixed bottom-5 right-5 z-40 rounded-full pl-4 pr-5 gap-2 shadow-lg shadow-primary/40 active:scale-95 lg:hidden"
  >
    <.icon name="hero-plus" class="size-5" />
    <span class="font-semibold">Neue Frage</span>
  </.link>

  <.confirm_modal
    id="delete-question-modal"
    show={@confirm_action == :delete_question}
    title="Frage löschen?"
    message="Diese Frage löschen?"
    confirm_label="Löschen"
    confirm_event="confirm_delete"
    cancel_event="cancel_confirm"
  />
</Layouts.app>
