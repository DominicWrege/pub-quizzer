<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
>
  <.header>
    <:back>
      <.link navigate={~p"/admin/topics"} class="btn btn-sm">
        ← Zurück zu Themen
      </.link>
    </:back>
    {@page_title}
    <:subtitle>{@topic.name}</:subtitle>
    <:actions>
      <div class="flex items-center gap-2">
        <form id="search-form" phx-change="search" class="contents">
          <input
            name="search"
            type="text"
            value={@search}
            placeholder="Suchen..."
            class="input input-sm"
          />
        </form>
        <button phx-click="start_new" class="btn btn-primary btn-sm">
          <.icon name="hero-plus" class="size-4" /> Neue Frage
        </button>
      </div>
    </:actions>
  </.header>

  <%= if @editing_question_id do %>
    <div class="card bg-base-200 shadow-sm mb-6">
      <div class="card-body">
        <h3 class="card-title text-lg">
          {if @editing_question_id == :new, do: "Neue Frage", else: "Frage bearbeiten"}
        </h3>
        <.form for={@form} id="question-form" phx-change="validate" phx-submit="save">
          <.input
            field={@form[:prompt]}
            type="textarea"
            label="Frage"
            placeholder="Wie lautet die Frage?"
          />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <%= for i <- 0..3 do %>
              <% letter = Enum.at(["a", "b", "c", "d"], i) %>
              <div class="fieldset mb-2">
                <label
                  for={"question_options_#{i}"}
                  class="label mb-1"
                >Option {String.upcase(letter)}</label>
                <input
                  type="text"
                  name={"question[options][#{i}]"}
                  id={"question_options_#{i}"}
                  value={Phoenix.HTML.Form.input_value(@form, :options) |> Enum.at(i) || ""}
                  class="w-full input"
                />
              </div>
            <% end %>
          </div>
          <.input
            field={@form[:correct_index]}
            type="number"
            label="Korrekte Option (0-3)"
            min="0"
            max="3"
          />
          <div id="image-upload-zone" phx-hook="ImagePreview" class="flex flex-col gap-2">
            <label class="text-sm font-semibold">Bild (optional)</label>
            <.live_file_input upload={@uploads.image} />
            <%= if @image_preview_url do %>
              <div class="relative w-fit">
                <img src={@image_preview_url} class="max-h-32 rounded-lg" />
                <button
                  type="button"
                  phx-click="cancel_upload"
                  phx-value-ref={hd(@uploads.image.entries).ref}
                  class="btn btn-error btn-xs absolute top-1 right-1"
                >
                  ×
                </button>
              </div>
            <% end %>
          </div>
          <div class="card-actions justify-end mt-4 gap-2">
            <button type="button" phx-click="cancel_edit" class="btn btn-sm">Abbrechen</button>
            <button type="submit" class="btn btn-primary btn-sm">Speichern</button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <.table id="questions" rows={@streams.questions} row_id={fn {id, _} -> id end}>
    <:col :let={{_id, q}} label="#"><span class="opacity-60">{q.position + 1}</span></:col>
    <:col :let={{_id, q}} label="Frage">{q.prompt}</:col>
    <:col :let={{_id, q}} label="Optionen">{length(q.options)}</:col>
    <:col :let={{_id, q}} label="Korrekt">Option {q.correct_index + 1}</:col>
    <:action :let={{_id, q}}>
      <button
        phx-click="start_edit"
        phx-value-id={q.id}
        class="btn btn-sm"
      >
        <.icon name="hero-pencil" class="size-4" /> Bearbeiten
      </button>
      <button
        phx-click="ask_delete"
        phx-value-id={q.id}
        class="btn btn-sm text-error"
      >
        <.icon name="hero-trash" class="size-4" /> Löschen
      </button>
    </:action>
  </.table>

  <.confirm_modal
    id="delete-question-modal"
    show={@confirm_action == :delete_question}
    title="Frage löschen?"
    message="Diese Frage löschen?"
    confirm_label="Löschen"
    confirm_event="confirm_delete"
    cancel_event="cancel_confirm"
  />
</Layouts.app>
