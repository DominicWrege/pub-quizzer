<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
>
  <div
    data-sticky-bar
    class="sticky top-[var(--header-h,0px)] lg:top-0 z-10 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 bg-base-100 border-b border-transparent transition-[box-shadow,border-color] duration-200 pt-3 pb-3 lg:pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2 mb-4"
  >
    <.form for={%{}} id="topic-search" phx-change="search" class="group relative flex-1 max-w-sm">
      <.icon
        name="hero-magnifying-glass"
        class="pointer-events-none absolute z-10 left-3 top-1/2 size-4 -translate-y-1/2 text-base-content/50 transition-colors duration-150 group-focus-within:text-base-content/70"
      />
      <input
        type="text"
        name="query"
        placeholder="Nach Name oder Beschreibung suchen..."
        value={@search_query}
        class="input input-bordered peer w-full pl-10 pr-10"
      />
      <button
        type="button"
        data-clear-input
        aria-label="Suche leeren"
        class="absolute z-10 right-2 top-1/2 hidden size-7 -translate-y-1/2 items-center justify-center rounded-full text-base-content/50 transition duration-150 hover:bg-base-300 hover:text-base-content active:scale-90 peer-[:not(:placeholder-shown)]:flex"
      >
        <.icon name="hero-x-mark" class="size-4" />
      </button>
    </.form>
    <.button phx-click="start_new">
      <.icon name="hero-plus" class="size-4" /> Neues Thema
    </.button>
  </div>

  <%= if @editing_topic_id do %>
    <dialog
      id="topic-form-modal"
      phx-hook="Dialog"
      data-cancel-event="cancel_edit"
      class="m-auto rounded-box bg-base-100 p-4 sm:p-6 shadow-xl max-w-lg w-[calc(100%-2rem)] sm:w-full max-h-[90vh] overflow-y-auto"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <h3 class="text-lg font-bold">Neues Thema</h3>
        <button
          type="button"
          phx-click="cancel_edit"
          aria-label="Schließen"
          class="btn btn-circle btn-ghost btn-sm shrink-0"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>
      <.form for={@form} id="topic-form" phx-submit="save">
        <.input
          field={@form[:name]}
          type="text"
          label="Name"
        />
        <.input
          field={@form[:description]}
          type="text"
          label="Beschreibung"
          placeholder="Optional"
        />
        <div class="mt-4">
          <label class="flex items-center cursor-pointer gap-2">
            <span class="text-sm font-medium">Aktiv</span>
            <input type="hidden" name="topic[enabled]" value="false" />
            <input
              type="checkbox"
              name="topic[enabled]"
              value="true"
              class="toggle toggle-primary"
              checked={@form[:enabled].value}
            />
          </label>
        </div>
        <div class="flex justify-end items-center mt-6">
          <button type="submit" class="btn btn-primary btn-sm">Speichern</button>
        </div>
      </.form>
    </dialog>
  <% end %>

  <%= if @filtered_topics == [] do %>
    <div class="text-center py-12 text-base-content/50">
      <%= if @search_query != "" do %>
        Keine Themen gefunden
      <% else %>
        Noch keine Themen erstellt.
      <% end %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= for topic <- @filtered_topics do %>
        <div
          id={"topics-#{topic.id}"}
          class={[
            "card bg-base-200 shadow-sm",
            !topic.enabled && "opacity-80 border-2 border-dashed border-base-300"
          ]}
        >
          <div class="card-body gap-2 pb-3">
            <div class="flex items-center justify-between gap-2">
              <h3 class="card-title text-lg">{topic.name}</h3>
              <%= if topic.enabled do %>
                <span class="badge badge-success badge-sm">Aktiv</span>
              <% else %>
                <span class="badge badge-ghost badge-sm">Deaktiviert</span>
              <% end %>
            </div>
            <p class="text-sm text-base-content/80">{topic.description}</p>
            <p class="text-sm text-base-content/70">{length(topic.questions)} Fragen</p>
          </div>
          <div class="flex justify-end gap-2 px-6 py-3 border-t border-base-300">
            <.link
              navigate={~p"/admin/topics/#{topic}/questions"}
              class="btn btn-primary btn-sm"
            >
              <.icon name="hero-pencil" class="size-4" /> Bearbeiten
            </.link>
            <.link
              href={~p"/admin/topics/#{topic}/export"}
              class="btn btn-primary btn-sm hidden lg:inline-flex"
            >
              <.icon name="hero-arrow-down-tray" class="size-4" /> PDF
            </.link>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</Layouts.app>
