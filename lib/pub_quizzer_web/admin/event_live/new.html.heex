<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@current_path}>
  <.header>
    <:back>
      <.link navigate={~p"/admin/events"} class="btn btn-sm btn-soft">
        ← Zurück
      </.link>
    </:back>
    Neues Quiz
    <:subtitle>Erstelle ein Quiz-Event mit einem 4-stelligen Beitrittscode.</:subtitle>
  </.header>

  <div class="max-w-sm">
    <.form for={@form} id="event-form" phx-submit="save">
      <.input
        field={@form[:name]}
        type="text"
        label="Name (optional)"
      />
      <.input
        field={@form[:team_count]}
        type="number"
        label="Anzahl der Teams"
        min="1"
        max="10"
        value={@form[:team_count].value}
      />
      <button type="submit" class="btn btn-primary mt-4">Quiz erstellen</button>
    </.form>
  </div>
</Layouts.app>
