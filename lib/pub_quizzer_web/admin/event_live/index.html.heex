<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
>
  <div
    data-sticky-bar
    class="sticky top-0 z-10 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 bg-base-100 border-b border-transparent transition-[box-shadow,border-color] duration-200 pt-3 pb-3 lg:pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2 mb-4"
  >
    <.form
      for={%{}}
      id="event-search"
      phx-change="search"
      class="group relative w-full sm:flex-1 sm:max-w-sm"
    >
      <.icon
        name="hero-magnifying-glass"
        class="pointer-events-none absolute z-10 left-3 top-1/2 size-4 -translate-y-1/2 text-base-content/50 transition-colors duration-150 group-focus-within:text-base-content/70"
      />
      <input
        type="text"
        name="query"
        placeholder="Nach Code oder Name suchen..."
        value={@search_query}
        class="input input-bordered peer w-full pl-10 pr-10"
      />
      <button
        type="button"
        data-clear-input
        aria-label="Suche leeren"
        class="absolute z-10 right-2 top-1/2 hidden size-7 -translate-y-1/2 items-center justify-center rounded-full text-base-content/50 transition duration-150 hover:bg-base-300 hover:text-base-content active:scale-90 peer-[:not(:placeholder-shown)]:flex"
      >
        <.icon name="hero-x-mark" class="size-4" />
      </button>
    </.form>
    <.button phx-click="start_new" id="new-event-btn">
      <.icon name="hero-plus" class="size-4" /> Neues Quiz
    </.button>
  </div>

  <%= if @show_new_dialog do %>
    <dialog
      id="event-form-modal"
      phx-hook="Dialog"
      data-cancel-event="cancel_new"
      class="m-auto rounded-box bg-base-100 p-4 sm:p-6 shadow-xl max-w-lg w-[calc(100%-2rem)] sm:w-full max-h-[90vh] overflow-y-auto"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <div>
          <h3 class="text-lg font-bold">Neues Quiz</h3>
          <p class="text-sm text-base-content/70 mt-1">
            Erstelle ein Quiz-Event mit einem 4-stelligen Beitrittscode.
          </p>
        </div>
        <button
          type="button"
          phx-click="cancel_new"
          aria-label="Schließen"
          class="btn btn-circle btn-ghost btn-sm shrink-0"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>
      <.form for={@form} id="event-form" phx-submit="save">
        <.input
          field={@form[:name]}
          type="text"
          label="Name (optional)"
        />
        <.input
          field={@form[:team_count]}
          type="number"
          label="Anzahl der Teams"
          min="1"
          max="10"
          value={@form[:team_count].value}
        />
        <div class="flex justify-end mt-6">
          <button type="submit" class="btn btn-primary btn-sm">Quiz erstellen</button>
        </div>
      </.form>
    </dialog>
  <% end %>

  <%= cond do %>
    <% @filtered_events == [] -> %>
      <div class="text-center py-12 text-base-content/70">
        <%= if @search_query != "" do %>
          Keine Quiz gefunden
        <% else %>
          Noch keine Quiz erstellt.
        <% end %>
      </div>
    <% true -> %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <%= for event <- @active_events do %>
          <.event_card event={event} />
        <% end %>
      </div>

      <%= if @finished_events != [] do %>
        <details class="mt-8 group" open>
          <summary class="cursor-pointer text-sm text-base-content/50 hover:text-base-content/80 transition-colors select-none">
            Beendete Quiz ({length(@finished_events)})
          </summary>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-3">
            <%= for event <- @finished_events do %>
              <.event_card event={event} />
            <% end %>
          </div>
        </details>
      <% end %>
  <% end %>

  <.confirm_modal
    id="delete-event-index-modal"
    show={@delete_event_id != nil}
    title="Veranstaltung löschen?"
    confirm_label="Löschen"
    confirm_event="confirm_delete"
    cancel_event="cancel_delete"
  >
    <p>
      <%= if event = Enum.find(@events, &(&1.id == @delete_event_id)) do %>
        Veranstaltung <strong>{event.code}</strong>
        und alle zugehörigen Daten (Teams, Runden, Antworten)
        werden unwiderruflich gelöscht.
      <% else %>
        Diese Veranstaltung und alle zugehörigen Daten werden unwiderruflich gelöscht.
      <% end %>
    </p>
  </.confirm_modal>
</Layouts.app>
