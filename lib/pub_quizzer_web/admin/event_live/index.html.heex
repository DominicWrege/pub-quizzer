<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
>
  <.header>
    Quiz
    <:subtitle>Von dir erstellte Quiz.</:subtitle>
    <:actions>
      <.button navigate={~p"/admin/events/new"}>Neues Quiz</.button>
    </:actions>
  </.header>

  <div class="mb-6">
    <input
      type="text"
      placeholder="Nach Code oder Name suchen..."
      value={@search_query}
      phx-keyup="search"
      phx-change="search"
      phx-value-query={@search_query}
      class="input input-bordered w-full max-w-sm"
    />
  </div>

  <%= cond do %>
    <% @filtered_events == [] -> %>
      <div class="text-center py-12 text-base-content/70">
        <%= if @search_query != "" do %>
          Keine Quiz gefunden
        <% else %>
          Noch keine Quiz erstellt.
        <% end %>
      </div>
    <% true -> %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <%= for event <- @active_events do %>
          <.event_card event={event} />
        <% end %>
      </div>

      <%= if @finished_events != [] do %>
        <details class="mt-8 group">
          <summary class="cursor-pointer text-sm text-base-content/50 hover:text-base-content/80 transition-colors select-none">
            Beendete Quiz ({length(@finished_events)})
          </summary>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-3">
            <%= for event <- @finished_events do %>
              <.event_card event={event} />
            <% end %>
          </div>
        </details>
      <% end %>
  <% end %>

  <%= if @delete_event_id do %>
    <% event = Enum.find(@events, &(&1.id == @delete_event_id)) %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="text-lg font-bold">Veranstaltung löschen?</h3>
        <p class="py-4">
          <%= if event do %>
            Veranstaltung <strong>{event.code}</strong>
            und alle zugehörigen Daten (Teams, Runden, Antworten)
            werden unwiderruflich gelöscht.
          <% else %>
            Diese Veranstaltung und alle zugehörigen Daten werden unwiderruflich gelöscht.
          <% end %>
        </p>
        <div class="modal-action">
          <button phx-click="cancel_delete" class="btn btn-sm">Abbrechen</button>
          <button phx-click="confirm_delete" class="btn btn-sm btn-error">Löschen</button>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>
