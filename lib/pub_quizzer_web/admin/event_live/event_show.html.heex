<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-3xl"
>
  <.header>
    <:back>
      <.link navigate={~p"/admin/events"} class="btn btn-sm btn-soft">
        <.icon name="hero-chevron-left" class="size-4" /> Zurück
      </.link>
    </:back>
    <%= if @event.name && @event.name != "" do %>
      {@event.name}
    <% else %>
      Event
    <% end %>
    <span class="badge badge-sm">{status_label(@event.status)}</span>
    <:actions>
      <%= if @event.status != "lobby" do %>
        <.link navigate={~p"/admin/events/#{@event}/results"} class="btn btn-sm btn-soft">
          <%= if @event.status == "finished" do %>
            <.icon name="hero-clipboard" class="size-4" /> Ergebnisse
          <% else %>
            <.icon name="hero-play" class="size-4" /> Live
          <% end %>
        </.link>
      <% end %>
      <%= if @event.status != "lobby" do %>
        <.link navigate={~p"/quiz/#{@event.code}/host"} class="btn btn-primary btn-sm">Moderator-Konsole</.link>
      <% end %>
      <button
        phx-click="ask_delete_event"
        class="btn btn-sm btn-danger-soft"
      >
        <.icon name="hero-trash" class="size-4" /> Löschen
      </button>
    </:actions>
  </.header>

  <.confirm_modal
    id="delete-event-modal"
    show={@confirm_action == :delete}
    title="Event löschen?"
    message="Event und alle Daten unwiderruflich löschen?"
    confirm_label="Löschen"
    confirm_event="do_delete_event"
    cancel_event="cancel_action"
  />

  <%= if @event.status == "lobby" do %>
    <div class="flex flex-col items-center gap-6 mb-12">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-8">
        <div class="flex flex-col items-center gap-2">
          <div
            data-testid="event-code"
            class="text-6xl font-mono font-bold tracking-widest bg-base-200 rounded-box px-8 py-4"
          >
            {@event.code}
          </div>
          <div class="text-sm text-base-content/70 text-center">
            Code an Teams weitergeben
          </div>
          <code class="text-sm text-base-content break-all max-w-xs">{String.replace(
            @join_url,
            ~r"^https?://",
            ""
          )}</code>
        </div>
        <div class="flex flex-col items-center gap-2">
          <button
            phx-click="show_large_qr"
            class="bg-white p-3 rounded-box shadow-md hover:shadow-lg transition-shadow cursor-pointer"
          >
            {raw(@qr_svg)}
          </button>
          <div class="text-sm text-base-content/70 text-center">
            QR-Code scannen zum Beitreten
          </div>
          <button phx-click="show_large_qr" class="btn btn-xs btn-soft">
            <.icon name="hero-plus" class="size-3" /> Vergrößern
          </button>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 mb-6">
      <button phx-click="add_slot" class="btn btn-sm btn-soft">
        <.icon name="hero-plus" class="size-4" /> Team hinzufügen
      </button>
      <button phx-click="remove_slot" class="btn btn-sm btn-soft">
        <.icon name="hero-minus" class="size-4" /> Team entfernen
      </button>
      <button
        id="copy-join-link"
        phx-hook="CopyLink"
        data-url={@join_url}
        class="btn btn-sm btn-soft"
      >
        <.icon name="hero-clipboard" class="size-3" /> Link kopieren
      </button>
      <span class="flex-1"></span>
      <button
        phx-click="do_start"
        class="btn btn-primary btn-lg text-xl px-10 w-full sm:w-auto"
        disabled={!@all_teams_connected}
      >
        ▶ Quiz starten
      </button>
    </div>

    <div class="card bg-base-200 shadow-sm">
      <div class="card-body">
        <h3 class="card-title text-lg mb-3">{@event.team_count} Teams</h3>

        <%!-- Mobile: cards --%>
        <div id="event-team-cards" class="space-y-3 lg:hidden">
          <div
            :for={team <- @event.teams}
            id={"team-card-#{team.id}"}
            class="bg-base-100 border-2 border-base-300 rounded-xl px-4 pt-3 pb-3"
          >
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-sm font-semibold opacity-60">Team {team.slot_index + 1}</span>
              <%= if team.claimed_at do %>
                <%= if team.id in @connected_team_ids do %>
                  <span class="badge badge-success">Beigetreten</span>
                <% else %>
                  <span class="badge badge-warning">Getrennt</span>
                <% end %>
              <% else %>
                <span class="badge badge-neutral">Wartend</span>
              <% end %>
            </div>
            <input
              type="text"
              value={team.name}
              class="input input-bordered w-full"
              phx-blur="rename_team"
              phx-value-team_id={team.id}
              data-team-id={team.id}
            />
            <div class="flex items-center justify-end gap-2 mt-2 pt-2 border-t border-base-300">
              <%= if team.claimed_at do %>
                <button
                  phx-click="kick_team"
                  phx-value-team_id={team.id}
                  class="btn btn-sm btn-soft"
                  title="Team rauswerfen (alle Geräte trennen, Slot bleibt)"
                >
                  <.icon name="hero-arrow-right-on-rectangle" class="size-4" /> Rauswerfen
                </button>
              <% end %>
              <button
                phx-click="remove_team"
                phx-value-team_id={team.id}
                class="btn btn-sm btn-danger-soft"
                title="Team entfernen"
              >
                <.icon name="hero-x-mark" class="size-4" /> Entfernen
              </button>
            </div>
          </div>
        </div>

        <%!-- Desktop: table --%>
        <div class="text-lg hidden lg:block">
          <.table id="event-teams" rows={@event.teams} row_id={fn team -> "team-#{team.id}" end}>
            <:col :let={team} label="#">
              <span class="opacity-60">{team.slot_index + 1}</span>
            </:col>
            <:col :let={team} label="Team-Name">
              <input
                type="text"
                value={team.name}
                class="input input-bordered w-full"
                phx-blur="rename_team"
                phx-value-team_id={team.id}
                data-team-id={team.id}
              />
            </:col>
            <:col :let={team} label="Status">
              <%= if team.claimed_at do %>
                <%= if team.id in @connected_team_ids do %>
                  <span class="badge badge-lg badge-success">Beigetreten</span>
                <% else %>
                  <span class="badge badge-lg badge-warning">Getrennt</span>
                <% end %>
              <% else %>
                <span class="badge badge-lg badge-neutral">Wartend</span>
              <% end %>
            </:col>
            <:action :let={team}>
              <div class="flex gap-1">
                <%= if team.claimed_at do %>
                  <button
                    phx-click="kick_team"
                    phx-value-team_id={team.id}
                    class="btn btn-sm btn-soft"
                    title="Team rauswerfen (alle Geräte trennen, Slot bleibt)"
                  >
                    <.icon name="hero-arrow-right-on-rectangle" class="size-4" />
                  </button>
                <% end %>
                <button
                  phx-click="remove_team"
                  phx-value-team_id={team.id}
                  class="btn btn-sm btn-danger-soft"
                  title="Team entfernen"
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </div>
            </:action>
          </.table>
        </div>
      </div>
    </div>

    <%= if @show_large_qr do %>
      <dialog
        id="large-qr-modal"
        phx-hook="Dialog"
        data-cancel-event="hide_large_qr"
        class="m-auto rounded-box bg-white p-8 shadow-xl"
        style="max-width: min(90vw, 800px);"
      >
        <div class="flex flex-col items-center gap-4">
          <div class="bg-white p-4 rounded-box">
            {raw(@qr_svg_large)}
          </div>
          <div class="text-center">
            <div class="text-4xl font-mono font-bold tracking-widest text-base-content">
              {@event.code}
            </div>
            <code class="text-sm text-base-content/70 break-all max-w-xs inline-block mt-2">
              {String.replace(@join_url, ~r"^https?://", "")}
            </code>
          </div>
          <button phx-click="hide_large_qr" class="btn btn-sm btn-soft mt-2">
            Schließen
          </button>
        </div>
      </dialog>
    <% end %>
  <% else %>
    <div class="alert alert-info text-base py-4">
      <.icon name="hero-information-circle" class="size-6" />
      <span>Dieses Event wurde bereits gestartet. Gehe zur Moderator-Konsole, um das Quiz zu leiten.</span>
    </div>
  <% end %>
</Layouts.app>
