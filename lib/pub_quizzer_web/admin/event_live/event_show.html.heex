<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-3xl"
>
  <div
    data-sticky-bar
    class="sticky top-(--header-h) lg:top-0 z-10 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 bg-base-100 border-b border-transparent transition-[box-shadow,border-color] duration-200 pt-3 pb-3 lg:pt-2 mb-4"
  >
    <.header class="sm:flex-row sm:items-center sm:gap-6 [&>div:last-child]:sm:w-auto">
      <:back>
        <.back_link navigate={~p"/admin/events"} />
      </:back>
      <span class="inline-flex min-w-0 flex-nowrap items-center gap-2">
        <%= if @event.name && @event.name != "" do %>
          <span class="min-w-0 flex-1 truncate">{@event.name}</span>
        <% else %>
          <span class="min-w-0 flex-1 truncate text-base-content/60">Event vom {Calendar.strftime(
            @event.inserted_at,
            "%d.%m.%Y"
          )}</span>
        <% end %>
      </span>
      <:actions>
        <button
          phx-click="open_edit_name"
          class="btn btn-sm btn-soft"
          aria-label="Event-Name bearbeiten"
        >
          <span class="max-sm:hidden"><.icon name="hero-pencil" class="size-4" /></span>
          Bearbeiten
        </button>
        <%= if @event.status != "lobby" do %>
          <.link navigate={~p"/admin/events/#{@event}/results"} class="btn btn-sm btn-soft">
            <%= if @event.status == "finished" do %>
              <.icon name="hero-clipboard" class="size-4" /> Ergebnisse
            <% else %>
              <.icon name="hero-play" class="size-4" /> Live
            <% end %>
          </.link>
          <.link navigate={~p"/quiz/#{@event.code}/host"} class="btn btn-sm btn-primary">Moderator-Konsole</.link>
        <% end %>
      </:actions>
    </.header>
  </div>

  <%= if @edit_name_dialog do %>
    <dialog
      id="event-name-dialog"
      phx-hook="Dialog"
      data-cancel-event="cancel_edit_name"
      class="m-auto rounded-box bg-base-100 p-6 shadow-xl w-[calc(100%-2rem)] sm:w-auto sm:min-w-sm max-w-md"
    >
      <div class="flex items-start justify-between gap-4">
        <h3 class="text-lg font-bold">Event-Name</h3>
        <button
          type="button"
          phx-click="cancel_edit_name"
          aria-label="Schließen"
          class="btn btn-circle btn-ghost btn-sm shrink-0"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>
      <.form for={@name_form} id="event-name-form" phx-submit="save_name">
        <div class="pt-4">
          <.input
            field={@name_form[:name]}
            type="text"
            label="Name"
            placeholder={"Event vom " <> Calendar.strftime(@event.inserted_at, "%d.%m.%Y")}
          />
        </div>
        <div class="flex justify-end mt-6">
          <button type="submit" class="btn btn-primary btn-sm">Speichern</button>
        </div>
      </.form>
    </dialog>
  <% end %>

  <div class="flex flex-col">
    <%= if @event.status == "lobby" do %>
      <%!-- Invite card: code + share actions in one row on tablet/desktop --%>
      <div class="card bg-base-200 border border-base-content/10 mt-2">
        <div class="card-body py-2!">
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
            <p
              data-testid="event-code"
              class="font-mono text-base sm:text-2xl font-bold tracking-[0.15em]"
            >
              {@event.code}
            </p>
            <div class="flex gap-2 sm:ms-auto max-sm:w-full">
              <button
                id="copy-join-link"
                phx-hook="CopyLink"
                phx-update="ignore"
                data-url={@join_url}
                class="btn btn-soft max-sm:flex-1 whitespace-nowrap"
              >
                <.icon name="hero-clipboard" class="size-4" /> Link
              </button>
              <.link
                navigate={~p"/admin/events/#{@event}/team-cards"}
                class="btn btn-soft max-sm:flex-1 whitespace-nowrap"
              >
                <.icon name="hero-qr-code" class="size-4" /> QR-Karten
              </.link>
            </div>
          </div>
        </div>
      </div>

      <section class="mt-3">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <p id="event-registration-summary" class="text-base font-semibold">
            {@registered_team_count} von {@event.team_count} Teams angemeldet
          </p>
          <button
            phx-click="add_slot"
            class="btn btn-soft btn-sm"
            disabled={@event.team_count >= 12}
          >
            <.icon name="hero-plus" class="size-4" /> Hinzufügen
          </button>
        </div>

        <%!-- Phones/tablets: compact team rows --%>
        <div id="event-team-cards" class="space-y-1.5 lg:hidden">
          <div
            :for={team <- @event.teams}
            id={"team-card-#{team.id}"}
            class="flex items-center gap-2 sm:gap-3 bg-base-200 border border-base-content/10 rounded-lg p-3"
          >
            <span
              id={"team-name-#{team.id}"}
              class="min-w-0 flex-1 truncate text-base font-medium"
              title={team.name}
            >
              {team.name}
            </span>
            <div class="flex shrink-0 items-center justify-end gap-2 sm:gap-3">
              <%= if team.claimed_at do %>
                <div class="flex flex-col items-end gap-0.5 text-right">
                  <span class="badge badge-sm badge-success badge-soft">Angemeldet</span>
                  <span class="text-xs text-base-content">
                    {if team.id in @connected_team_ids, do: "Online", else: "Zurzeit offline"}
                  </span>
                </div>
              <% else %>
                <span class="badge badge-sm badge-neutral badge-soft">Noch nicht gescannt</span>
              <% end %>
              <div class="flex items-center gap-2 shrink-0">
                <%= if team.claimed_at do %>
                  <button
                    id={"release-team-#{team.id}"}
                    phx-click="kick_team"
                    phx-value-team_id={team.id}
                    class="btn btn-soft btn-sm btn-square"
                    title="Anmeldung aufheben und Platz freigeben"
                    aria-label={"Platz für Team #{team.slot_index + 1} freigeben"}
                  >
                    <.icon name="hero-arrow-right-on-rectangle" class="size-4" />
                  </button>
                <% end %>
                <button
                  id={"remove-team-#{team.id}"}
                  phx-click="remove_team"
                  phx-value-team_id={team.id}
                  class="btn btn-outline btn-error btn-sm btn-square border-2"
                  disabled={@event.team_count <= 1}
                  aria-label={"Team #{team.slot_index + 1} entfernen"}
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </div>
            </div>
          </div>
        </div>

        <%!-- Desktop: table --%>
        <div class="text-lg hidden lg:block">
          <.table id="event-teams" rows={@event.teams} row_id={fn team -> "team-#{team.id}" end}>
            <:col :let={team} label="#" class="w-1">
              <span class="opacity-60">{team.slot_index + 1}</span>
            </:col>
            <:col :let={team} label="Team-Name">
              <span id={"desktop-team-name-#{team.id}"} class="font-medium">{team.name}</span>
            </:col>
            <:col :let={team} label="Status">
              <%= if team.claimed_at do %>
                <div class="flex flex-col items-start gap-1">
                  <span class="badge badge-lg badge-success badge-soft transition-colors duration-200">Angemeldet</span>
                  <span class="text-xs text-base-content">
                    {if team.id in @connected_team_ids, do: "Online", else: "Zurzeit offline"}
                  </span>
                </div>
              <% else %>
                <span class="badge badge-lg badge-neutral badge-soft transition-colors duration-200">Noch nicht gescannt</span>
              <% end %>
            </:col>
            <:action :let={team}>
              <div class="flex gap-1">
                <%= if team.claimed_at do %>
                  <button
                    phx-click="kick_team"
                    phx-value-team_id={team.id}
                    class="btn btn-sm btn-soft"
                    title="Anmeldung aufheben und Platz freigeben"
                    aria-label={"Platz für Team #{team.slot_index + 1} freigeben"}
                  >
                    <.icon name="hero-arrow-right-on-rectangle" class="size-4" />
                  </button>
                <% end %>
                <button
                  phx-click="remove_team"
                  phx-value-team_id={team.id}
                  class="btn btn-sm btn-outline btn-error border-2"
                  title="Team entfernen"
                  disabled={@event.team_count <= 1}
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </div>
            </:action>
          </.table>
        </div>

        <button
          id="start-quiz"
          phx-click="do_start"
          class="btn btn-primary btn-lg w-full mt-6 text-xl min-h-14"
          disabled={@registered_team_count == 0}
        >
          <.icon name="hero-play" class="size-6" /> Quiz starten
        </button>
        <p class="text-center text-sm text-base-content/60 mt-2">
          {start_hint(@registered_team_count)}
        </p>
      </section>
    <% else %>
      <div class="alert alert-info text-base py-4">
        <.icon name="hero-information-circle" class="size-6" />
        <span>Dieses Event wurde bereits gestartet. Gehe zur Moderator-Konsole, um das Quiz zu leiten.</span>
      </div>
    <% end %>
  </div>
</Layouts.app>
