<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
>
  <.header>
    Fragenkatalog importieren
    <:subtitle>
      JSON-Datei mit Themen und Fragen prüfen und beim Import einzelne oder alle Fragen veröffentlichen.
    </:subtitle>
  </.header>

  <%= if @imported != nil do %>
    <div class="alert alert-success items-start">
      <.icon name="hero-check-circle" class="size-5 shrink-0" />
      <div>
        <p class="font-semibold">Import abgeschlossen.</p>
        <ul class="mt-1 list-disc list-inside text-sm">
          <li :for={entry <- @imported}>
            {entry.name}: {entry.count} Frage(n) importiert
          </li>
        </ul>
      </div>
    </div>
    <button
      id="restart-import-button"
      type="button"
      phx-click="reset"
      class="btn btn-primary mt-2"
    >
      <.icon name="hero-arrow-path" class="size-4" /> Weiteren Import starten
    </button>
  <% else %>
    <.form
      for={%{}}
      id="import-form"
      phx-change="validate"
      phx-submit="preview"
      class="rounded-xl border-2 border-base-300 bg-base-100 p-4 sm:p-6 space-y-4"
    >
      <div>
        <span class="block text-sm font-medium mb-1">JSON-Datei</span>
        <.live_file_input
          upload={@uploads.catalog}
          class="file-input file-input-bordered w-full"
        />
        <p class="text-xs text-base-content/60 mt-1">
          Erwartet ein Objekt mit einem <code>quizzes</code>-Array (Themen mit Fragen).
          Bereits vorhandene Themen werden übersprungen.
        </p>
      </div>

      <div
        :for={entry <- @uploads.catalog.entries}
        id={"import-entry-#{entry.ref}"}
        class="flex items-center justify-between gap-2 rounded-lg bg-base-200 px-3 py-2 text-sm"
      >
        <span class="truncate">{entry.client_name}</span>
        <%= for error <- upload_errors(@uploads.catalog, entry) do %>
          <span class="badge badge-error badge-sm shrink-0">{upload_error_label(error)}</span>
        <% end %>
      </div>

      <div class="flex justify-end">
        <button type="submit" class="btn btn-primary btn-sm px-8">
          <.icon name="hero-magnifying-glass" class="size-4" /> Prüfen
        </button>
      </div>
    </.form>

    <%= if @file_error do %>
      <div class="alert alert-error mt-4 items-start">
        <.icon name="hero-exclamation-circle" class="size-5 shrink-0" />
        <span>{@file_error}</span>
      </div>
    <% end %>

    <%= if @result do %>
      <.import_preview result={@result} />
    <% end %>
  <% end %>
</Layouts.app>
