<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
  print_chrome={false}
>
  <div class="print:hidden">
    <.header>
      <:back>
        <.back_link navigate={~p"/admin/events/#{@event}"} />
      </:back>
      Team-Karten
      <:subtitle>
        {@event.code} · {@event.team_count} Teams
      </:subtitle>
      <:actions>
        <button
          onclick="window.print()"
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-arrow-down-tray" class="size-4" /> Drucken
        </button>
      </:actions>
    </.header>

    <div class="alert alert-info text-sm mt-4">
      <.icon name="hero-information-circle" class="size-5" />
      <span>
        Jede Karte ist eine eigene Seite. Code-URLs sind bereits eingetragen — einfach auf Karteindruck drucken und die Karten austeilen.
      </span>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto print:block print:gap-0 print:mt-0 print:max-w-none print:mx-0">
    <div
      :for={%{team: team, slot: slot, svg: svg} <- @cards}
      id={"team-card-#{team.id}"}
      data-test="team-card"
      data-slot={slot}
      class={
        [
          # screen: daisyUI card chrome (kept per design decision)
          "team-card card bg-base-200",
          # print: blank A5 sheet, no chrome, content centered
          "print:bg-white print:border-0 print:shadow-none print:rounded-none",
          "print:max-w-none print:mx-0 print:w-[148mm] print:min-h-[210mm]",
          "print:flex print:flex-col print:justify-center"
        ]
      }
    >
      <div class={[
        "card-body items-center text-center p-8",
        "print:p-16 print:gap-8"
      ]}>
        <div class="text-3xl sm:text-4xl font-bold tracking-tight print:text-3xl">
          Team {slot}
        </div>
        <div class="mt-4 bg-white px-6 py-3 rounded-box shadow-sm print:mt-0 print:p-0 print:shadow-none print:rounded-none">
          {raw(svg)}
        </div>
        <div class="mt-6 text-base text-base-content/70 print:mt-0">
          <span class="font-mono">Code:</span>
          <span class="font-mono font-bold tracking-widest text-2xl text-base-content print:text-3xl">
            {@event.code}
          </span>
        </div>
        <p class="mt-4 text-xs text-base-content/50 max-w-md print:mt-2 print:text-sm print:text-base-content/60">
          QR-Code scannen mit der Kamera-App, um als Team {slot} beizutreten.
        </p>
      </div>
    </div>
  </div>
</Layouts.app>
