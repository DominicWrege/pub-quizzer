<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
  print_chrome={false}
>
  <div class="print:hidden">
    <.header>
      <:back>
        <.back_link navigate={~p"/admin/events/#{@event}"} />
      </:back>
      Team-Karten
      <:subtitle>
        {@event.code} · {@event.team_count} Teams
      </:subtitle>
      <:actions>
        <button
          id="print-team-cards"
          onclick="window.print()"
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-printer" class="size-4" /> Drucken
        </button>
      </:actions>
    </.header>
  </div>

  <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 print:block print:gap-0 print:mt-0 print:max-w-none print:mx-0">
    <div
      :for={%{team: team, slot: slot, url: url, display_url: display_url, svg: svg} <- @cards}
      id={"team-card-#{team.id}"}
      data-test="team-card"
      data-slot={slot}
      class={
        [
          # screen: daisyUI card chrome
          "team-card card bg-base-100 border-2 border-base-300",
           # print: content-sized card so browser print scaling cannot expand
           # an artificial minimum height onto an empty second sheet
          "print:bg-white print:border-0 print:shadow-none print:rounded-none",
           "print:max-w-none print:mx-0 print:w-full",
          "print:flex print:flex-col"
        ]
      }
    >
      <div class={[
        "card-body items-center text-center p-8",
        "print:p-16 print:gap-6 print:justify-center"
      ]}>
        <div class="text-3xl sm:text-4xl font-bold tracking-tight print:text-5xl">
          Team {slot}
        </div>
        <div class="team-card-qr mt-2 bg-white px-4 py-2 rounded-box print:mt-0 print:p-0 print:rounded-none">
          {raw(svg)}
        </div>
        <button
          id={"copy-team-link-#{team.id}"}
          phx-hook="CopyLink"
          phx-update="ignore"
          data-url={url}
          class="btn btn-sm btn-soft mt-3 print:hidden"
        >
          <.icon name="hero-clipboard" class="size-4" /> Link kopieren
        </button>
        <div class="mt-3 hidden text-base text-base-content/70 print:block print:mt-0">
          <span class="font-mono font-semibold tracking-tight text-sm text-base-content break-words print:text-lg">
            {display_url}
          </span>
        </div>
        <div class="mt-3 hidden flex-col items-center gap-1.5 text-xs text-base-content/60 print:flex print:mt-0 print:text-base">
          <span class="inline-flex items-center gap-1.5">
            <.icon name="hero-camera" class="size-4" />
            QR-Code scannen oder Link im Browser eingeben
          </span>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
