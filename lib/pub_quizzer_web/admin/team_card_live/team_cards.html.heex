<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-lg"
>
  <div class="print:hidden">
    <.header>
      <:back>
        <.back_link navigate={~p"/admin/events/#{@event}"} />
      </:back>
      Team-Karten
      <:subtitle>
        {@event.code} · {@event.team_count} Teams
      </:subtitle>
      <:actions>
        <button
          onclick="window.print()"
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-arrow-down-tray" class="size-4" /> Drucken
        </button>
      </:actions>
    </.header>

    <div class="alert alert-info text-sm mt-4">
      <.icon name="hero-information-circle" class="size-5" />
      <span>
        Jede Karte ist eine eigene Seite. Code-URLs sind bereits eingetragen — einfach auf Karteindruck drucken und die Karten austeilen.
      </span>
    </div>
  </div>

  <div class="mt-6 space-y-6 print:mt-0 print:space-y-0">
    <div
      :for={%{team: team, slot: slot, svg: svg} <- @cards}
      id={"team-card-#{team.id}"}
      data-test="team-card"
      data-slot={slot}
      class="team-card card bg-base-200 max-w-sm mx-auto print:shadow-none print:border-0 print:bg-white"
    >
      <div class="card-body items-center text-center p-8 print:p-12">
        <div class="text-5xl sm:text-6xl font-bold tracking-tight">
          Team {slot}
        </div>
        <div class="mt-6 bg-white p-4 rounded-box shadow-sm print:shadow-none">
          {raw(svg)}
        </div>
        <div class="mt-6 text-base text-base-content/70">
          <span class="font-mono">Code:</span>
          <span class="font-mono font-bold tracking-widest text-2xl text-base-content">
            {@event.code}
          </span>
        </div>
        <p class="mt-4 text-xs text-base-content/50 max-w-md">
          QR-Code scannen mit der Kamera-App, um als Team {slot} beizutreten.
        </p>
      </div>
    </div>
  </div>
</Layouts.app>
