<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={@current_path}
  max_width="max-w-4xl"
  print_chrome={false}
>
  <div class="print:hidden">
    <.header>
      <:back>
        <.back_link navigate={~p"/admin/events/#{@event}"} />
      </:back>
      Team-Karten
      <:subtitle>
        {@event.code} · {@event.team_count} Teams
      </:subtitle>
      <:actions>
        <button
          onclick="window.print()"
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-arrow-down-tray" class="size-4" /> Drucken
        </button>
      </:actions>
    </.header>

    <div class="alert alert-info text-sm mt-4">
      <.icon name="hero-information-circle" class="size-5" />
      <span>
        Jede Karte ist eine eigene Seite. Code-URLs sind bereits eingetragen — einfach auf Karteindruck drucken und die Karten austeilen.
      </span>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 print:block print:gap-0 print:mt-0 print:max-w-none print:mx-0">
    <div
      :for={%{team: team, slot: slot, display_url: display_url, svg: svg} <- @cards}
      id={"team-card-#{team.id}"}
      data-test="team-card"
      data-slot={slot}
      class={
        [
          # screen: daisyUI card chrome
          "team-card card bg-base-100 border border-base-300",
          # print: blank A5 sheet, no chrome, content centered
          "print:bg-white print:border-0 print:shadow-none print:rounded-none",
          "print:max-w-none print:mx-0 print:w-[148mm] print:min-h-[210mm]",
          "print:flex print:flex-col print:justify-center"
        ]
      }
    >
      <div class={[
        "card-body items-center text-center p-8",
        "print:p-12 print:gap-4"
      ]}>
        <div class="text-3xl sm:text-4xl font-bold tracking-tight print:text-3xl">
          Team {slot}
        </div>
        <div class="team-card-qr mt-2 bg-white px-4 py-2 rounded-box print:mt-0 print:p-0 print:rounded-none">
          {raw(svg)}
        </div>
        <div class="mt-3 hidden text-base text-base-content/70 print:block print:mt-0">
          <span class="font-mono font-semibold tracking-tight text-sm text-base-content break-words print:text-base">
            {display_url}
          </span>
        </div>
        <div class="mt-3 hidden flex-col items-center gap-1.5 text-xs text-base-content/60 print:flex print:mt-0 print:text-sm print:text-base-content/70">
          <span class="inline-flex items-center gap-1.5">
            <.icon name="hero-camera" class="size-4" /> QR-Code scannen oder Link im Browser eingeben
          </span>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
