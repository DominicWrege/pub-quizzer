<Layouts.app
  flash={@flash}
  max_width=""
  hide_nav_actions
  main_class="px-4 py-4 sm:pt-2 sm:pb-10 sm:px-6 lg:px-8"
>
  <div class="border-b border-base-300 host-header">
    <.header>
      <:back>
        <%= if @engine_state.status == :finished do %>
          <.back_link navigate={~p"/admin/events"} />
        <% end %>
      </:back>
      Moderatoren-Konsole
      <:subtitle>
        Quiz-Code: <span class="font-mono font-bold">{@event.code}</span>
        · Runde {(@engine_state.round_number || 0) + 1}
      </:subtitle>
      <:actions>
        <%= if @engine_state.status != :finished do %>
          <div class="flex items-center gap-1 mr-2 sm:mr-4">
            <button
              onclick="adjustFontSize(-1)"
              class="btn btn-sm btn-soft btn-square transition-colors duration-150"
              title="Kleine Schrift"
            >A−</button>
            <span
              id="qfz-label"
              class="text-xs w-10 text-center tabular-nums text-base-content/70"
            >100%</span>
            <button
              onclick="adjustFontSize(1)"
              class="btn btn-sm btn-soft btn-square transition-colors duration-150"
              title="Große Schrift"
            >A+</button>
          </div>
          <%= if @engine_state.status == :question do %>
            <% all_answered = map_size(@engine_state.answers) == length(@engine_state.teams) %>
            <%= if (@engine_state.question_index || 0) < length(@engine_state.current_questions) - 1 do %>
              <button
                phx-click="next_question"
                class="btn btn-sm btn-primary"
                disabled={!all_answered}
              >
                <.icon name="hero-chevron-right" class="size-4" /> Nächste Frage
              </button>
            <% else %>
              <button
                phx-click="reveal_round"
                class="btn btn-sm btn-primary"
                disabled={!all_answered}
              >
                <.icon name="hero-eye" class="size-4" /> Runde auflösen
              </button>
            <% end %>
          <% end %>
          <button
            onclick="togglePresentation()"
            class="btn btn-sm btn-primary pres-mode-toggle"
          >
            Präsentationsmodus <kbd class="kbd kbd-xs">P</kbd>
          </button>
          <button
            phx-click="ask_finish_quiz"
            class="btn btn-sm btn-soft pres-mode-hide"
          >
            <.icon name="hero-flag" class="size-4" /> Quiz beenden
          </button>
        <% end %>
      </:actions>
    </.header>
  </div>
  <div class="fixed top-4 right-4 z-[9999] presentation-exit">
    <button
      onclick="togglePresentation()"
      class="btn btn-sm btn-square"
      title="Präsentationsmodus beenden (Esc)"
    >
      <.icon name="hero-x-mark" class="size-5" />
    </button>
  </div>

  <div id="host-lobby-main" phx-hook="ScrollToBottom" class="mx-auto space-y-6 max-w-7xl">
    <%!-- Topic selection phase --%>
    <%= if @engine_state.status == :topic_selection do %>
      <div class="mb-4 animate-fade-in-up">
        <%= if @engine_state.current_chooser_team_id do %>
          <% chooser =
            Enum.find(@engine_state.teams, fn t ->
              t.id == @engine_state.current_chooser_team_id
            end) %>
          <div class="alert alert-info max-w-2xl mx-auto text-2xl font-semibold">
            <.icon name="hero-hand-raised" class="size-8" />
            <span><strong>{chooser.name}</strong>
            hat Runde {@engine_state.round_number} gewonnen — Vortritt</span>
          </div>
        <% else %>
          <div class="alert alert-info text-xl">
            <.icon name="hero-hand-raised" class="size-6" />
            <span>
              <strong>Moderator wählt das Thema</strong>
              <%= if @engine_state.round_number == 0 do %>
                (Runde 1)
              <% else %>
                (Remis oder kein Gewinner in der letzten Runde)
              <% end %>
            </span>
          </div>
        <% end %>

        <h3 class="text-4xl font-bold mb-8 mt-6">Verfügbare Themen</h3>
        <div class="grid grid-cols-3 gap-6">
          <%= for topic <- @available_topics do %>
            <button
              phx-click="choose_topic"
              phx-value-topic_id={topic.id}
              class="btn btn-primary h-auto py-12 px-8 flex-col items-center gap-4 min-h-[180px] text-base-100 shadow-lg hover:scale-[1.02] hover:shadow-xl transition-[transform,box-shadow] duration-200"
            >
              <.icon name="hero-bookmark" class="size-10" />
              <span class="text-4xl font-bold">{topic.name}</span>
              <%= if topic[:description] do %>
                <span class="text-xl font-normal opacity-80">{topic[:description]}</span>
              <% end %>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

    <%!-- Question phase --%>
    <%= if @engine_state.status == :question do %>
      <% question = @engine_state.current_questions |> Enum.at(@engine_state.question_index) %>
      <% answered = PubQuizzer.Quiz.EngineState.answered_teams(@engine_state) %>
      <% total_teams = length(@engine_state.teams) %>

      <div class="mb-4">
        <div class="flex items-center justify-between">
          <div class="flex items-baseline gap-2 flex-wrap">
            <h3 class="text-xl font-semibold">
              Frage {(@engine_state.question_index || 0) + 1} / {length(
                @engine_state.current_questions
              )}
            </h3>
            <%= if @current_topic_name do %>
              <span class="text-sm text-base-content/60">{@current_topic_name}</span>
            <% end %>
          </div>
          <span class="badge badge-ghost text-lg px-4 py-2 transition-all duration-300">
            {MapSet.size(answered)} / {total_teams} Teams geantwortet
          </span>
        </div>
      </div>

      <.question_slide question={question} id="quiz-qa-area" class="mb-4 animate-fade-in" />
    <% end %>

    <%!-- Round reveal phase --%>
    <%= if @engine_state.status == :round_reveal do %>
      <% revealed = @engine_state.reveal_answer_index %>
      <% total = length(@engine_state.current_questions) %>
      <% all_revealed = revealed >= total %>

      <%!-- Paginated answer reveal — one Q&A at a time --%>
      <%= if !all_revealed or !@round_summary_shown do %>
        <% view_index = @reveal_view_index || 0 %>
        <% question = @engine_state.current_questions |> Enum.at(view_index) %>

        <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-xl font-semibold">
            <span data-test="reveal-counter">
              Frage {view_index + 1} / {total}
            </span>
          </h3>
          <div class="flex flex-wrap items-center gap-2">
            <button
              phx-click="reveal_prev_answer"
              class="btn btn-sm btn-soft"
              disabled={view_index == 0}
            >
              <.icon name="hero-chevron-left" class="size-4" /> Zurück
            </button>

            <%= if !all_revealed or view_index < revealed - 1 do %>
              <button
                phx-click="reveal_next_answer"
                class="btn btn-sm btn-primary"
              >
                Nächste Antwort <.icon name="hero-chevron-right" class="size-4" />
              </button>
            <% end %>

            <%= if all_revealed and view_index == total - 1 do %>
              <button
                phx-click="show_round_summary"
                class="btn btn-sm btn-primary"
              >
                <.icon name="hero-trophy" class="size-4" /> Ergebnis anzeigen
              </button>
            <% end %>
          </div>
        </div>

        <div class="card bg-base-200 animate-fade-in" data-test="reveal-question">
          <div class="card-body px-12 sm:px-16 py-8">
            <h4 class="card-title text-2xl">
              <.multiline_text text={question.prompt} />
            </h4>
            <%= if (question[:images] || []) != [] do %>
              <div class="flex flex-wrap justify-center items-center gap-4 mb-2">
                <%= for img <- question[:images] do %>
                  <.question_image
                    img={img}
                    class="w-[clamp(20rem,45vw,40rem)] h-auto object-contain"
                    sizes="(max-width: 640px) 100vw, 768px"
                    loading="lazy"
                  />
                <% end %>
              </div>
            <% end %>
            <div class="space-y-4">
              <%= for {option, idx} <- Enum.with_index(question.options) do %>
                <div class={[
                  "p-5 rounded text-2xl flex items-center gap-3",
                  idx == question.correct_index && "pq-reveal-correct border-2",
                  idx != question.correct_index && "bg-base-300"
                ]}>
                  <span class="font-mono shrink-0">{letter_for_index(idx)}.</span>
                  <span class="break-words flex-1"><.multiline_text text={option["text"]} /></span>
                  <%= if opt_img = option["image"] do %>
                    <img
                      src={thumbnail_url(opt_img)}
                      srcset={srcset_for(opt_img)}
                      sizes="128px"
                      alt=""
                      loading="lazy"
                      class="size-[6vw] max-w-[6rem] object-cover rounded shrink-0"
                    />
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <%= if all_revealed and @round_summary_shown do %>
        <%= if @engine_state.standings_revealed do %>
          <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-xl font-semibold">🏆 Platzierung</h3>
            <button phx-click="next_round" class="btn btn-primary btn-lg text-xl">
              <.icon name="hero-chevron-right" class="size-6" /> Nächste Runde
            </button>
          </div>
          <div class="space-y-4 animate-fade-in-up">
            <%= for {{id, name, score}, rank} <- Enum.with_index(@standings) do %>
              <.podium_row
                id={"standing-#{id}"}
                rank={rank}
                name={name}
                score={score}
              />
            <% end %>
          </div>
        <% else %>
          <% winner =
            Enum.find(@engine_state.teams, fn t ->
              t.id == @engine_state.current_winner_team_id
            end) %>
          <div class="mb-6">
            <%= if winner do %>
              <div class="alert alert-success text-2xl font-semibold justify-center">
                <.icon name="hero-trophy" class="size-8 text-warning" />
                <span><strong>{winner.name}</strong>
                gewinnt Runde {(@engine_state.round_number || 0) + 1}</span>
              </div>
            <% else %>
              <div class="alert alert-info text-xl justify-center">
                <.icon name="hero-hand-raised" class="size-6" />
                <span>Remis! Kein eindeutiger Gewinner.</span>
              </div>
            <% end %>
          </div>

          <div class="mb-6 flex flex-wrap items-center justify-center gap-3">
            <button phx-click="show_standings" class="btn btn-lg text-xl px-12 py-4 btn-soft">
              <.icon name="hero-clipboard" class="size-7" /> Team-Ergebnisse anzeigen
            </button>
            <button phx-click="next_round" class="btn btn-primary btn-lg text-2xl px-12 py-4">
              <.icon name="hero-bookmark" class="size-5" /> Weiter zur Kategorie
            </button>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%!-- Finished phase --%>
    <%= if @engine_state.status == :finished do %>
      <div class="text-center mt-20 mb-6 animate-fade-in">
        <.icon name="hero-trophy" class="size-20 mx-auto text-warning" />
        <h2 class="text-3xl font-bold mt-2">Quiz beendet!</h2>
      </div>

      <%= if Map.get(@engine_state, :final_results_revealed, false) do %>
        <%!-- Winner — compact, minimal --%>
        <%= if @standings != [] do %>
          <% [first | _rest] = @standings %>
          <% {_, winner_name, winner_score} = first %>
          <div id="host-winner-line" class="text-center mb-6">
            <span class="text-xl font-semibold">
              <strong>{winner_name}</strong> gewinnt mit {winner_score} Punkten!
            </span>
          </div>
        <% else %>
          <div class="alert alert-warning text-lg">
            <.icon name="hero-exclamation-triangle" class="size-6" />
            <span>Keine Teams vorhanden.</span>
          </div>
        <% end %>
      <% else %>
        <div class="text-center mt-6">
          <button
            phx-click="reveal_final_results"
            class="btn btn-primary text-lg px-8 py-3"
          >
            Ergebnisse für Teams freigeben
          </button>
        </div>
      <% end %>

      <div class="mt-5 flex justify-center gap-3">
        <.link
          navigate={~p"/admin/events"}
          class="btn btn-soft text-base px-6 py-2.5"
        >
          <.icon name="hero-chevron-left" class="size-5" /> Zurück zur Übersicht
        </.link>
        <%= if Map.get(@engine_state, :final_results_revealed, false) do %>
          <.link
            navigate={~p"/admin/events/#{@event.id}/results"}
            class="btn btn-soft text-base px-6 py-2.5"
          >
            <.icon name="hero-clipboard" class="size-5" /> Antworten ansehen
          </.link>
        <% end %>
      </div>
    <% end %>
  </div>

  <.confirm_modal
    id="finish-quiz-modal"
    show={@confirm_action == :finish_quiz}
    title="Quiz beenden?"
    message="Quiz vorzeitig beenden?"
    confirm_label="Beenden"
    confirm_event="confirm_finish_quiz"
    cancel_event="cancel_confirm"
  />
</Layouts.app>
