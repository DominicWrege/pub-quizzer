<Layouts.app
  flash={@flash}
  max_width={if @engine_state.status == :question, do: "max-w-3xl", else: "max-w-2xl"}
  hide_nav_actions
  sticky_nav
  main_class="px-4 py-4 sm:pt-2 sm:pb-10 sm:px-6 lg:px-8 text-sm"
>
  <:nav_title>
    <div class="flex items-center gap-2 min-w-0">
      <.link
        id="host-home"
        navigate={~p"/admin/events"}
        class="btn btn-sm btn-soft btn-square min-h-[44px] min-w-[44px] shrink-0"
        aria-label="Zur Quiz-Übersicht"
      >
        <.icon name="hero-home" class="size-5" />
      </.link>
      <%= if @engine_state.status == :question do %>
        <div class="flex items-baseline gap-2 min-w-0">
          <h3 class="text-base font-semibold shrink-0">
            Frage {(@engine_state.question_index || 0) + 1} / {length(
              @engine_state.current_questions
            )}
          </h3>
          <span
            :if={@current_topic_name}
            id="host-question-topic"
            class="text-sm text-base-content truncate"
          >
            {@current_topic_name}
          </span>
        </div>
      <% else %>
        <span class="text-base font-semibold truncate">
          <%= case @engine_state.status do %>
            <% :topic_selection -> %>
              Themenwahl
            <% :round_reveal -> %>
              Runde {(@engine_state.round_number || 0) + 1} · Auswertung
            <% :finished -> %>
              Quiz beendet
            <% _ -> %>
              Quiz
          <% end %>
        </span>
      <% end %>
    </div>
  </:nav_title>
  <:nav_actions>
    <button
      :if={@engine_state.status == :question}
      id="host-answer-count"
      phx-click="toggle_pending_teams"
      aria-expanded={to_string(@pending_teams_visible?)}
      aria-controls="host-pending-teams"
      title="Teams ohne Antwort anzeigen"
      class="btn btn-sm btn-soft min-h-[44px] px-3 text-sm shrink-0 tabular-nums"
      data-test="answered-badge"
    >
      <%= if @digital_teams == [] do %>
        Papier
      <% else %>
        {length(@digital_teams) - length(@pending_digital_teams)} / {length(@digital_teams)}
      <% end %>
      <.icon
        name="hero-chevron-right"
        class={[
          "size-4 transition-transform",
          if(@pending_teams_visible?, do: "-rotate-90", else: "rotate-90")
        ]}
      />
    </button>
    <%!-- Tablet and up: direct actions. On phones everything lives in the
         hamburger menu, so the right side of the header stays one button. --%>
    <.link
      id="host-live-values"
      navigate={~p"/admin/events/#{@event.id}/results"}
      class="btn btn-sm btn-soft min-h-[44px] gap-1 px-2 shrink-0 hidden sm:inline-flex"
      aria-label={
        if @engine_state.status == :finished,
          do: "Ergebnisse anzeigen",
          else: "Live-Ergebnisse anzeigen"
      }
    >
      <.icon name="hero-clipboard" class="size-4 shrink-0" />
      {if @engine_state.status == :finished, do: "Ergebnisse", else: "Live-Ergebnisse"}
    </.link>
    <button
      :if={@engine_state.status != :finished}
      id="host-finish-quiz"
      phx-click="ask_finish_quiz"
      class="btn btn-sm btn-outline min-h-[44px] gap-1 px-2 shrink-0 hidden sm:inline-flex"
    >
      <.icon name="hero-flag" class="size-4 shrink-0" /> Quiz beenden
    </button>

    <details
      id="host-quiz-menu"
      class="dropdown dropdown-end sm:hidden"
      phx-mounted={JS.ignore_attributes(["open"])}
      phx-click-away={JS.remove_attribute("open", to: "#host-quiz-menu")}
    >
      <summary
        class="btn btn-sm btn-soft btn-square min-h-[44px] min-w-[44px]"
        aria-label="Quiz-Menü"
      >
        <.icon name="hero-bars-3" class="size-5" />
      </summary>
      <ul class="dropdown-content menu bg-base-100 rounded-box shadow-lg w-56 p-2 mt-2 z-50 border border-base-300">
        <li>
          <.link
            id="host-live-values-menu"
            navigate={~p"/admin/events/#{@event.id}/results"}
            class="btn btn-sm btn-soft justify-start"
          >
            <.icon name="hero-clipboard" class="size-4" />
            {if @engine_state.status == :finished, do: "Ergebnisse", else: "Live-Ergebnisse"}
          </.link>
        </li>
        <li :if={@engine_state.status != :finished} class="mt-1">
          <button
            id="host-finish-quiz-menu"
            phx-click={
              JS.remove_attribute("open", to: "#host-quiz-menu") |> JS.push("ask_finish_quiz")
            }
            class="btn btn-sm btn-outline justify-start"
          >
            <.icon name="hero-flag" class="size-4" /> Quiz beenden
          </button>
        </li>
      </ul>
    </details>
  </:nav_actions>

  <div id="host-screen-control" phx-hook="HostScreen" phx-update="ignore" class="hidden"></div>

  <div id="host-lobby-main" phx-hook="ScrollToBottom" class="mx-auto space-y-4">
    <%!-- Topic selection phase --%>
    <%= if @engine_state.status == :topic_selection do %>
      <div class="mb-4 animate-fade-in-up">
        <%= if @engine_state.current_chooser_team_id do %>
          <% chooser =
            Enum.find(@engine_state.teams, fn t ->
              t.id == @engine_state.current_chooser_team_id
            end) %>
          <div class="alert alert-info max-w-2xl mx-auto text-base font-semibold">
            <.icon name="hero-hand-raised" class="size-5" />
            <span><strong>Runde {@engine_state.round_number + 1}</strong>
            · {chooser.name} wählt das Thema</span>
          </div>
        <% else %>
          <div class="alert alert-info text-base">
            <.icon name="hero-hand-raised" class="size-5" />
            <span>
              <strong>Runde {@engine_state.round_number + 1}</strong>
              · Moderator wählt das Thema
              <%= if @engine_state.round_number > 0 do %>
                (Remis oder kein Gewinner in der letzten Runde)
              <% end %>
            </span>
          </div>
        <% end %>

        <h3 class="text-xl font-bold mb-4 mt-5">Verfügbare Themen</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <%= for topic <- @available_topics do %>
            <button
              phx-click="choose_topic"
              phx-value-topic_id={topic.id}
              class="btn btn-primary min-w-0 h-auto min-h-16 sm:min-h-20 px-3 py-2 flex-col items-center gap-1 text-primary-content shadow-lg hover:scale-[1.02] hover:shadow-xl transition-[transform,box-shadow] duration-200"
            >
              <.icon name="hero-bookmark" class="size-5 sm:size-6 shrink-0" />
              <span class="block max-w-full whitespace-normal break-words text-center text-base font-bold leading-tight">{topic.name}</span>
              <%= if topic[:description] do %>
                <span class="max-w-full whitespace-normal break-words text-center text-sm font-normal opacity-80">{topic[
                  :description
                ]}</span>
              <% end %>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

    <%!-- Question phase --%>
    <%= if @engine_state.status == :question do %>
      <% question = @engine_state.current_questions |> Enum.at(@engine_state.question_index) %>
      <% all_answered = @pending_digital_teams == [] %>
      <% has_next =
        (@engine_state.question_index || 0) < length(@engine_state.current_questions) - 1 %>

      <div class="flex flex-col gap-3 animate-fade-in">
        <div
          id="host-pending-teams"
          hidden={!@pending_teams_visible?}
          class="rounded-lg border border-base-300 bg-base-200 px-4 py-3 text-sm break-words"
        >
          <%= if all_answered do %>
            Alle Teams haben geantwortet.
          <% else %>
            <span class="font-semibold">Antwort fehlt:</span>
            {Enum.map_join(@pending_digital_teams, ", ", & &1.name)}
          <% end %>
        </div>

        <section
          id="host-question-card"
          class="mt-4 space-y-5 text-base-content"
          aria-labelledby="host-question-prompt"
        >
          <h2
            id="host-question-prompt"
            class="text-[23px] font-semibold leading-[1.43] break-words"
            data-test="question-prompt"
          >
            <.multiline_text text={question.prompt} />
          </h2>

          <ol
            id="host-answer-options"
            class="divide-y divide-base-300 border-t border-base-300"
            aria-label="Antwortmöglichkeiten"
            data-test="answer-distribution"
          >
            <%= for {option, idx} <- Enum.with_index(question.options) do %>
              <li
                id={"host-answer-option-#{idx}"}
                class="grid grid-cols-[44px_minmax(0,1fr)] items-start gap-3 sm:gap-4 py-4 sm:py-5"
                data-test="distribution-row"
              >
                <span class="size-[44px] flex items-center justify-center rounded-lg border border-base-300 bg-base-200 text-[23px] font-semibold">
                  {letter_for_index(idx)}
                </span>
                <span
                  id={"host-answer-text-#{idx}"}
                  class="min-w-0 pt-[3px] text-[23px] font-medium leading-[1.45] break-words"
                >
                  <.multiline_text text={option["text"]} />
                </span>
              </li>
            <% end %>
          </ol>
        </section>

        <section
          :if={@paper_teams != []}
          id="host-paper-round"
          class="rounded-xl border border-base-300 bg-base-200 overflow-hidden"
          aria-labelledby="host-paper-title"
        >
          <div class="px-4 py-3">
            <div class="flex-1 min-w-0">
              <h3 id="host-paper-title" class="text-base font-bold">
                Auf Papier · Runde {@engine_state.round_number + 1}
              </h3>
              <p class="text-sm mt-1">
                {if has_next,
                  do: "Bögen am Rundenende einsammeln. Die anderen Teams spielen digital weiter.",
                  else: "Bögen einsammeln und Antworten vor der Auflösung erfassen."}
              </p>
            </div>
          </div>
          <ul class="divide-y divide-base-300 border-t border-base-300">
            <li :for={team <- @paper_teams} class="flex flex-wrap items-center gap-3 px-4 py-3">
              <span class="flex-1 min-w-0 text-base font-semibold break-words">{team.name}</span>
              <span
                id={"host-paper-status-#{team.id}"}
                class={[
                  "badge badge-soft shrink-0",
                  if(team.id in @engine_state.paper_submitted_team_ids,
                    do: "badge-success",
                    else: "badge-neutral"
                  )
                ]}
              >
                {if team.id in @engine_state.paper_submitted_team_ids,
                  do: "Erfasst",
                  else: "Bogen ausstehend"}
              </span>
              <button
                :if={!has_next}
                id={"host-enter-paper-#{team.id}"}
                phx-click="open_paper_answers"
                phx-value-team_id={team.id}
                class="btn btn-ghost btn-xs border-0 shadow-none shrink-0"
              >
                {if team.id in @engine_state.paper_submitted_team_ids,
                  do: "Bearbeiten",
                  else: "Antworten eintragen"}
              </button>
            </li>
          </ul>
        </section>

        <div class="sticky bottom-0 z-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 pb-4 pt-2 bg-base-100/95 backdrop-blur border-t border-base-300">
          <div class="flex items-center gap-3">
            <span
              id="host-question-timer"
              phx-hook=".HostQuestionTimer"
              phx-update="ignore"
              data-question-key={"#{@engine_state.round_number}-#{@engine_state.question_index}"}
              role="timer"
              aria-label="Zeit für diese Frage"
              aria-live="off"
              class="inline-flex items-center gap-1 text-base font-semibold tabular-nums shrink-0 min-h-[44px]"
            >
              <.icon name="hero-clock" class="size-5" />
              <span data-timer-value>00:00</span>
            </span>
            <button
              phx-click="next_question"
              class="btn btn-primary btn-lg flex-1 text-base"
              data-test="advance-button"
            >
              <%= cond do %>
                <% has_next -> %>
                  <.icon name="hero-chevron-right" class="size-5" /> Nächste Frage
                <% @pending_paper_teams != [] -> %>
                  Papierantworten erfassen
                <% true -> %>
                  <.icon name="hero-eye" class="size-5" /> Runde auflösen
              <% end %>
            </button>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Round reveal — winner next to the next-topic button; stats and ranking collapsed --%>
    <%= if @engine_state.status == :round_reveal do %>
      <div class="space-y-4 animate-fade-in">
        <%!-- Per-question distribution breakdowns — collapsed by default --%>
        <details
          id="host-round-stats"
          phx-mounted={JS.ignore_attributes(["open"])}
          class="collapse collapse-arrow border border-base-300 bg-base-200"
        >
          <summary class="collapse-title font-semibold">
            Fragen-Auswertung ({length(@round_distributions)})
          </summary>
          <div class="collapse-content">
            <div class="space-y-3" data-test="round-stat-list">
              <%= for {question, distribution} <- @round_distributions do %>
                <div class="card bg-base-200">
                  <div class="card-body p-4 sm:p-5">
                    <div class="flex items-baseline gap-2 mb-1">
                      <span class="text-xs font-mono text-base-content/60 shrink-0">
                        Frage {(question.position || 0) + 1}
                      </span>
                    </div>
                    <h4 class="card-title text-[1.1rem] leading-snug break-words">
                      <.multiline_text text={question.prompt} />
                    </h4>

                    <ul class="mt-2 divide-y divide-base-300">
                      <%= for {option, idx} <- Enum.with_index(question.options) do %>
                        <% count = Map.get(distribution, idx, 0) %>
                        <% is_correct = idx == question.correct_index %>
                        <li class={[
                          "flex items-center gap-3 rounded px-2 py-1.5",
                          is_correct && "bg-success/15"
                        ]}>
                          <span class={[
                            "font-mono w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center rounded text-sm shrink-0",
                            is_correct && "bg-success text-success-content",
                            !is_correct && "bg-base-300 text-base-content/70"
                          ]}>
                            {letter_for_index(idx)}
                          </span>
                          <span class="flex-1 min-w-0 text-[0.9625rem] break-words">
                            <.multiline_text text={option["text"]} />
                          </span>
                          <%= if is_correct do %>
                            <.icon name="hero-check-circle" class="size-4 text-success shrink-0" />
                          <% end %>
                          <span class="tabular-nums text-xs sm:text-sm w-5 text-right shrink-0">{count}</span>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </details>

        <%!-- Ranking — host-only, expanded by default --%>
        <details
          id="host-round-standings"
          open
          phx-mounted={JS.ignore_attributes(["open"])}
          class="collapse collapse-arrow border border-base-300 bg-base-200"
        >
          <summary class="collapse-title font-semibold">Platzierung</summary>
          <div class="collapse-content">
            <ol class="space-y-2" data-test="standings-list">
              <%= for {{id, name, total, delta}, rank} <- Enum.with_index(@standings_with_deltas) do %>
                <li
                  id={"standing-#{id}"}
                  class={[
                    "flex items-center gap-3 p-3 rounded-lg border",
                    rank == 0 && "border-warning bg-warning/10",
                    rank == 1 && "border-base-content/30 bg-base-200",
                    rank >= 2 && "border-base-300 bg-base-200"
                  ]}
                >
                  <span class="font-bold text-lg w-8 text-center shrink-0">
                    <%= cond do %>
                      <% rank == 0 -> %>
                        🥇
                      <% rank == 1 -> %>
                        🥈
                      <% rank == 2 -> %>
                        🥉
                      <% true -> %>
                        {rank + 1}
                    <% end %>
                  </span>
                  <span class="flex-1 font-semibold text-sm truncate">{name}</span>
                  <%= if delta > 0 do %>
                    <span class="badge badge-success badge-sm shrink-0">+{delta}</span>
                  <% end %>
                  <span class="tabular-nums text-base font-bold shrink-0">{total}</span>
                </li>
              <% end %>
            </ol>
          </div>
        </details>

        <% winner =
          Enum.find(@engine_state.teams, &(&1.id == @engine_state.current_winner_team_id)) %>
        <% round_score =
          @standings_with_deltas |> Enum.map(&elem(&1, 3)) |> Enum.max(fn -> 0 end) %>
        <% round_leaders = Enum.filter(@standings_with_deltas, &(elem(&1, 3) == round_score)) %>

        <div class="sticky bottom-0 z-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 pb-4 pt-2 bg-base-100/95 backdrop-blur border-t border-base-300">
          <div class="flex flex-col sm:flex-row sm:items-center gap-2">
            <%= cond do %>
              <% winner -> %>
                <div
                  id="host-round-winner"
                  class="alert alert-success text-sm font-semibold flex-1 min-w-0"
                >
                  <.icon name="hero-trophy" class="size-5" />
                  <span><strong>{winner.name}</strong> gewinnt die Runde!</span>
                </div>
              <% length(round_leaders) > 1 -> %>
                <div id="host-round-tie" class="alert alert-info text-sm flex-1 min-w-0">
                  <.icon name="hero-hand-raised" class="size-5" />
                  <span>
                    <strong>Remis: {Enum.map_join(round_leaders, ", ", &elem(&1, 1))}</strong>
                    mit je {round_score} {if round_score == 1, do: "Punkt", else: "Punkten"} in dieser Runde.
                  </span>
                </div>
              <% true -> %>
                <div id="host-round-no-winner" class="alert alert-info text-sm flex-1 min-w-0">
                  <.icon name="hero-hand-raised" class="size-5" />
                  <span>Kein Rundensieger.</span>
                </div>
            <% end %>
            <button phx-click="next_round" class="btn btn-primary btn-lg text-base sm:shrink-0">
              <.icon name="hero-bookmark" class="size-5" /> Nächstes Thema wählen
            </button>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Finished phase --%>
    <%= if @engine_state.status == :finished do %>
      <div class="text-center mt-20 mb-6 animate-fade-in">
        <.icon name="hero-trophy" class="size-20 mx-auto text-warning" />
        <h2 class="text-xl font-bold mt-2">Quiz beendet!</h2>
      </div>

      <%= if Map.get(@engine_state, :final_results_revealed, false) do %>
        <%!-- Winner — compact, minimal --%>
        <%= if @standings != [] do %>
          <% [first | _rest] = @standings %>
          <% {_, winner_name, winner_score} = first %>
          <div id="host-winner-line" class="text-center mb-6">
            <span class="text-base font-semibold">
              <strong>{winner_name}</strong> gewinnt mit {winner_score} Punkten!
            </span>
          </div>
        <% else %>
          <div class="alert alert-warning text-base">
            <.icon name="hero-exclamation-triangle" class="size-6" />
            <span>Keine Teams vorhanden.</span>
          </div>
        <% end %>
      <% else %>
        <div class="text-center mt-6">
          <button
            phx-click="reveal_final_results"
            class="btn btn-primary text-base px-8 py-3"
          >
            Ergebnisse für Teams freigeben
          </button>
        </div>
      <% end %>

      <%= if Map.get(@engine_state, :final_results_revealed, false) do %>
        <div class="mt-5 flex justify-center">
          <.link
            navigate={~p"/admin/events/#{@event.id}/results"}
            class="btn btn-soft text-base px-6 py-2.5"
          >
            <.icon name="hero-clipboard" class="size-5" /> Antworten ansehen
          </.link>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= if @engine_state.status != :finished do %>
    <details
      id="host-teams"
      phx-mounted={JS.ignore_attributes(["open"])}
      class="collapse collapse-arrow border border-base-300 bg-base-200 mt-[64px]"
    >
      <summary class="collapse-title font-semibold">
        Teams verwalten · {length(@engine_state.teams)}
      </summary>
      <div class="collapse-content">
        <ul id="host-team-list" phx-update="stream" class="divide-y divide-base-300">
          <li
            :for={{dom_id, team} <- @streams.teams}
            id={dom_id}
            class="flex flex-wrap items-center gap-2 py-3"
          >
            <span id={"host-team-#{team.id}"} class="flex-1 min-w-0 font-medium break-words">{team.name}</span>
            <span
              class={[
                "badge badge-sm badge-soft",
                if(team.id in @connected_team_ids, do: "badge-success", else: "badge-warning")
              ]}
              data-test="team-connection"
            >
              {if team.id in @connected_team_ids, do: "Online", else: "Offline"}
            </span>
            <span
              :if={length(@engine_state.teams) == 1}
              id={"host-last-team-#{team.id}"}
              class="text-xs text-base-content"
            >
              Ein Team muss bleiben
            </span>
            <button
              :if={@engine_state.status == :question}
              id={"host-paper-team-#{team.id}"}
              phx-click="set_paper_mode"
              phx-value-team_id={team.id}
              phx-value-round_id={@engine_state.current_round_id}
              phx-value-enabled={to_string(team.id not in @engine_state.paper_team_ids)}
              aria-pressed={to_string(team.id in @engine_state.paper_team_ids)}
              class="btn btn-ghost btn-xs border-0 shadow-none shrink-0"
            >
              {if team.id in @engine_state.paper_team_ids,
                do: "Zurück zum Handy",
                else: "Auf Papier wechseln"}
            </button>
            <button
              :if={length(@engine_state.teams) > 1}
              id={"host-remove-team-#{team.id}"}
              phx-click="ask_remove_team"
              phx-value-team_id={team.id}
              class="btn btn-sm btn-soft btn-error shrink-0"
              aria-label={"#{team.name} entfernen"}
            >
              <.icon name="hero-trash" class="size-4" /> Team entfernen
            </button>
          </li>
        </ul>
      </div>
    </details>
  <% end %>

  <p class="text-center text-sm text-base-content/60 mt-6">
    Quiz-Code: <span class="font-mono font-bold">{@event.code}</span>
  </p>

  <.confirm_modal
    id="finish-quiz-modal"
    show={@confirm_action == :finish_quiz}
    title="Quiz beenden?"
    message="Quiz vorzeitig beenden?"
    confirm_label="Beenden"
    confirm_event="confirm_finish_quiz"
    cancel_event="cancel_confirm"
  />

  <%= case @confirm_action do %>
    <% {:next_question, _question_key} -> %>
      <% missing_names =
        Enum.map_join(@pending_digital_teams, ", ", & &1.name) %>
      <.confirm_modal
        id="next-question-modal"
        show
        title="Ohne alle Antworten fortfahren?"
        message={"Antwort fehlt: #{missing_names}. Nicht beantwortete Fragen zählen als 0 Punkte."}
        confirm_label={
          if @engine_state.question_index < length(@engine_state.current_questions) - 1,
            do: "Nächste Frage",
            else: "Runde auflösen"
        }
        confirm_event="confirm_next_question"
        cancel_event="cancel_confirm"
      />
    <% {:remove_team, team} -> %>
      <.confirm_modal
        id="remove-team-modal"
        show
        title={"#{team.name} entfernen?"}
        message="Das Team und seine Antworten werden aus dem Quiz entfernt. Der QR-Code ist danach ungültig."
        confirm_label="Team entfernen"
        confirm_event="confirm_remove_team"
        cancel_event="cancel_confirm"
      />
    <% _ -> %>
  <% end %>

  <dialog
    :if={@paper_entry}
    id="paper-answers-dialog"
    phx-hook="Dialog"
    data-cancel-event="close_paper_answers"
    aria-labelledby="paper-answers-title"
    aria-describedby="paper-answers-description"
    class="m-auto w-[calc(100%-2rem)] max-w-md max-h-[calc(100dvh-2rem)] rounded-xl border border-base-300 bg-base-100 text-base-content p-0 shadow-sm"
  >
    <div class="sticky top-0 z-10 border-b border-base-300 bg-base-100 px-4 py-3">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 id="paper-answers-title" class="text-base font-bold break-words">
            {@paper_entry.team.name}
          </h2>
          <p class="text-xs mt-1 break-words">
            Papier · Runde {@engine_state.round_number + 1} · {@current_topic_name}
          </p>
        </div>
        <button
          id="paper-answers-close"
          type="button"
          phx-click="close_paper_answers"
          class="btn btn-square btn-sm bg-base-300 hover:bg-base-content/15 border-transparent shrink-0"
          aria-label="Schließen"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>
    </div>
    <.form for={@paper_form} id="paper-answers-form" phx-submit="save_paper_answers">
      <div class="px-4 py-3 space-y-3">
        <p id="paper-answers-description" class="text-xs leading-relaxed">
          A–D vom Bogen übertragen. – = keine Antwort.
          Vorhandene Antworten bleiben erhalten.
        </p>
        <div class="divide-y divide-base-300 rounded-lg border border-base-300 overflow-hidden">
          <fieldset
            :for={question <- @engine_state.current_questions}
            class="grid grid-cols-[4rem_auto] items-center gap-2 px-3 py-2"
          >
            <% field = @paper_form[to_string(question.id)] %>
            <% existing = @paper_entry.original[question.id] %>
            <legend class="sr-only">Frage {question.position + 1}</legend>
            <.input field={field} type="hidden" />
            <div>
              <span class="text-sm font-semibold">Frage {question.position + 1}</span>
              <p :if={!is_nil(existing)} id={"paper-existing-#{question.id}"} class="text-xs">
                {if @paper_entry.sources[question.id] == "paper", do: "Papier", else: "Digital"}:
                <strong>{letter_for_index(existing)}</strong>
              </p>
            </div>
            <div
              class="join justify-self-end"
              role="group"
              aria-label={"Antwort für Frage #{question.position + 1}"}
            >
              <button
                :for={idx <- 0..(length(question.options) - 1)}
                id={"paper-choice-#{question.id}-#{idx}"}
                type="button"
                phx-click="pick_paper_answer"
                phx-value-question_id={question.id}
                phx-value-choice={idx}
                aria-pressed={to_string(field.value == to_string(idx))}
                class={[
                  "btn btn-sm btn-square sm:size-10 sm:text-sm join-item font-bold font-mono border-transparent",
                  if(field.value == to_string(idx),
                    do: "btn-primary",
                    else: "bg-base-300 hover:bg-base-content/15"
                  )
                ]}
              >
                {letter_for_index(idx)}
              </button>
              <button
                id={"paper-blank-#{question.id}"}
                type="button"
                phx-click="pick_paper_answer"
                phx-value-question_id={question.id}
                phx-value-choice="-"
                aria-pressed={to_string(field.value == "-")}
                aria-label={
                  if is_nil(existing), do: "Keine Antwort", else: "Gespeicherte Antwort behalten"
                }
                title={
                  if is_nil(existing), do: "Keine Antwort", else: "Gespeicherte Antwort behalten"
                }
                class={[
                  "btn btn-sm btn-square sm:size-10 sm:text-sm join-item border-transparent",
                  if(field.value == "-",
                    do: "btn-primary",
                    else: "bg-base-300 hover:bg-base-content/15"
                  )
                ]}
              >
                –
              </button>
            </div>
          </fieldset>
        </div>
        <div
          :if={@paper_entry.error}
          id="paper-entry-error"
          class="alert alert-error text-sm"
          role="alert"
        >
          <.icon name="hero-exclamation-triangle" class="size-5" />
          <span>{@paper_entry.error}</span>
        </div>
        <div
          :if={@paper_entry.overwrite?}
          id="paper-overwrite-warning"
          class="rounded-lg border border-warning bg-base-200 p-4"
          role="alert"
        >
          <h3 class="font-bold">Gespeicherte Antworten ersetzen?</h3>
          <ul class="mt-2 space-y-1 text-sm">
            <%= for question <- @engine_state.current_questions,
                    old = @paper_entry.original[question.id],
                    new = @paper_entry.picks[to_string(question.id)],
                    not is_nil(old) and new != "-" and new != to_string(old) do %>
              <li>
                Frage {question.position + 1}: <strong>{letter_for_index(old)}</strong>
                → <strong>{letter_for_index(String.to_integer(new))}</strong>
              </li>
            <% end %>
          </ul>
          <button
            id="paper-confirm-overwrite"
            type="button"
            phx-click="confirm_paper_overwrite"
            class="btn btn-sm bg-base-300 hover:bg-base-content/15 border-transparent mt-3"
          >Ersetzen und speichern</button>
        </div>
      </div>
      <div class="sticky bottom-0 border-t border-base-300 bg-base-100 px-4 py-3 flex items-center justify-between gap-3">
        <% entered = Enum.count(@paper_entry.picks, fn {_id, value} -> value != "unselected" end) %>
        <div class="text-xs">
          <span class="font-semibold">{entered} / {length(@engine_state.current_questions)} erfasst</span>
          <span class="block">Noch nicht gespeichert</span>
        </div>
        <button
          id="paper-save"
          type="submit"
          disabled={entered != length(@engine_state.current_questions) or @paper_entry.overwrite?}
          class="btn btn-sm btn-primary shrink-0"
        >
          Bogen speichern
        </button>
      </div>
    </.form>
  </dialog>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".HostQuestionTimer">
    export default {
      mounted() {
        this.reset()
      },
      updated() {
        if (this.questionKey !== this.el.dataset.questionKey) this.reset()
      },
      destroyed() {
        clearInterval(this.interval)
      },
      reset() {
        clearInterval(this.interval)
        this.questionKey = this.el.dataset.questionKey
        this.startedAt = performance.now()
        this.value = this.el.querySelector("[data-timer-value]")
        this.tick()
        this.interval = setInterval(() => this.tick(), 1000)
      },
      tick() {
        const seconds = Math.floor((performance.now() - this.startedAt) / 1000)
        const minutes = String(Math.floor(seconds / 60)).padStart(2, "0")
        const remainder = String(seconds % 60).padStart(2, "0")
        this.value.textContent = `${minutes}:${remainder}`
      }
    }
  </script>
</Layouts.app>
