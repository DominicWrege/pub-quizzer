<Layouts.app
  flash={@flash}
  max_width="max-w-2xl"
  hide_nav_actions
  main_class="px-4 py-4 sm:pt-2 sm:pb-10 sm:px-6 lg:px-8"
>
  <div class="border-b border-base-300 host-header">
    <.header>
      <:back>
        <%= if @engine_state.status == :finished do %>
          <.back_link navigate={~p"/admin/events"} />
        <% end %>
      </:back>
      Moderatoren-Konsole
      <:subtitle>
        Quiz-Code: <span class="font-mono font-bold">{@event.code}</span>
        · Runde {(@engine_state.round_number || 0) + 1}
      </:subtitle>
      <:actions>
        <%= if @engine_state.status != :finished do %>
          <button
            phx-click="ask_finish_quiz"
            class="btn btn-sm btn-soft"
          >
            <.icon name="hero-flag" class="size-4" /> Quiz beenden
          </button>
        <% end %>
      </:actions>
    </.header>
  </div>

  <div id="host-lobby-main" phx-hook="ScrollToBottom" class="mx-auto space-y-6">
    <%!-- Topic selection phase --%>
    <%= if @engine_state.status == :topic_selection do %>
      <div class="mb-4 animate-fade-in-up">
        <%= if @engine_state.current_chooser_team_id do %>
          <% chooser =
            Enum.find(@engine_state.teams, fn t ->
              t.id == @engine_state.current_chooser_team_id
            end) %>
          <div class="alert alert-info max-w-2xl mx-auto text-2xl font-semibold">
            <.icon name="hero-hand-raised" class="size-8" />
            <span><strong>{chooser.name}</strong>
            hat Runde {@engine_state.round_number} gewonnen — Vortritt</span>
          </div>
        <% else %>
          <div class="alert alert-info text-xl">
            <.icon name="hero-hand-raised" class="size-6" />
            <span>
              <strong>Moderator wählt das Thema</strong>
              <%= if @engine_state.round_number == 0 do %>
                (Runde 1)
              <% else %>
                (Remis oder kein Gewinner in der letzten Runde)
              <% end %>
            </span>
          </div>
        <% end %>

        <h3 class="text-4xl font-bold mb-8 mt-6">Verfügbare Themen</h3>
        <div class="grid grid-cols-3 gap-6">
          <%= for topic <- @available_topics do %>
            <button
              phx-click="choose_topic"
              phx-value-topic_id={topic.id}
              class="btn btn-primary h-auto py-12 px-8 flex-col items-center gap-4 min-h-[180px] text-base-100 shadow-lg hover:scale-[1.02] hover:shadow-xl transition-[transform,box-shadow] duration-200"
            >
              <.icon name="hero-bookmark" class="size-10" />
              <span class="text-4xl font-bold">{topic.name}</span>
              <%= if topic[:description] do %>
                <span class="text-xl font-normal opacity-80">{topic[:description]}</span>
              <% end %>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

    <%!-- Question phase --%>
    <%= if @engine_state.status == :question do %>
      <% question = @engine_state.current_questions |> Enum.at(@engine_state.question_index) %>
      <% answered = PubQuizzer.Quiz.EngineState.answered_teams(@engine_state) %>
      <% total_teams = length(@engine_state.teams) %>
      <% total_picks = @answer_distribution |> Map.values() |> Enum.sum() %>
      <% all_answered = MapSet.size(answered) == total_teams %>
      <% has_next =
        (@engine_state.question_index || 0) < length(@engine_state.current_questions) - 1 %>

      <div class="space-y-4 animate-fade-in">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-baseline gap-2 flex-wrap min-w-0">
            <h3 class="text-xl font-semibold shrink-0">
              Frage {(@engine_state.question_index || 0) + 1} / {length(
                @engine_state.current_questions
              )}
            </h3>
            <%= if @current_topic_name do %>
              <span class="text-sm text-base-content/60 truncate">{@current_topic_name}</span>
            <% end %>
          </div>
          <span
            class="badge badge-lg badge-ghost px-4 py-3 text-base shrink-0 tabular-nums"
            data-test="answered-badge"
          >
            {MapSet.size(answered)} / {total_teams}
          </span>
        </div>

        <div class="card bg-base-200">
          <div class="card-body p-5 sm:p-6">
            <h4
              class="card-title text-lg sm:text-xl leading-snug break-words"
              data-test="question-prompt"
            >
              <.multiline_text text={question.prompt} />
            </h4>

            <ul class="mt-2 space-y-2" data-test="answer-distribution">
              <%= for {option, idx} <- Enum.with_index(question.options) do %>
                <% count = Map.get(@answer_distribution, idx, 0) %>
                <% pct =
                  if total_picks > 0, do: Integer.floor_div(count * 100, total_picks), else: 0 %>
                <li class="flex items-center gap-3" data-test="distribution-row">
                  <span class="font-mono w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded bg-base-300 text-base-content/70 text-sm sm:text-base shrink-0">
                    {letter_for_index(idx)}
                  </span>
                  <span class="flex-1 min-w-0 text-base sm:text-lg break-words">
                    <.multiline_text text={option["text"]} />
                  </span>
                  <div class="flex items-center gap-2 w-28 sm:w-40 shrink-0">
                    <div class="flex-1 h-3 bg-base-300 rounded overflow-hidden">
                      <div
                        class="h-full bg-primary transition-all duration-300"
                        style={"width: #{pct}%"}
                      >
                      </div>
                    </div>
                    <span class="tabular-nums text-sm sm:text-base w-6 text-right">{count}</span>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        </div>

        <button
          phx-click={(has_next && "next_question") || "reveal_round"}
          disabled={!all_answered}
          class="btn btn-primary btn-lg w-full text-lg"
          data-test="advance-button"
        >
          <%= if has_next do %>
            <.icon name="hero-chevron-right" class="size-5" /> Nächste Frage
          <% else %>
            <.icon name="hero-eye" class="size-5" /> Runde auflösen
          <% end %>
        </button>
      </div>
    <% end %>

    <%!-- Round reveal phase — stats-first, no paginated slide --%>
    <%= if @engine_state.status == :round_reveal do %>
      <div class="space-y-4 animate-fade-in">
        <h3 class="text-xl font-semibold">
          Runde {(@engine_state.round_number || 0) + 1} · Auswertung
        </h3>

        <%!-- Per-question distribution breakdowns — all questions in the round --%>
        <div class="space-y-3" data-test="round-stat-list">
          <%= for {question, distribution} <- @round_distributions do %>
            <% q_total_picks = distribution |> Map.values() |> Enum.sum() %>
            <div class="card bg-base-200">
              <div class="card-body p-4 sm:p-5">
                <div class="flex items-baseline gap-2 mb-1">
                  <span class="text-xs font-mono text-base-content/60 shrink-0">
                    Frage {(question.position || 0) + 1}
                  </span>
                </div>
                <h4 class="card-title text-base sm:text-lg leading-snug break-words">
                  <.multiline_text text={question.prompt} />
                </h4>

                <ul class="mt-2 space-y-1.5">
                  <%= for {option, idx} <- Enum.with_index(question.options) do %>
                    <% count = Map.get(distribution, idx, 0) %>
                    <% pct =
                      if q_total_picks > 0,
                        do: Integer.floor_div(count * 100, q_total_picks),
                        else: 0 %>
                    <% is_correct = idx == question.correct_index %>
                    <li class={[
                      "flex items-center gap-3 rounded px-2 py-1.5",
                      is_correct && "bg-success/15"
                    ]}>
                      <span class={[
                        "font-mono w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center rounded text-sm shrink-0",
                        is_correct && "bg-success text-success-content",
                        !is_correct && "bg-base-300 text-base-content/70"
                      ]}>
                        {letter_for_index(idx)}
                      </span>
                      <span class="flex-1 min-w-0 text-sm sm:text-base break-words">
                        <.multiline_text text={option["text"]} />
                      </span>
                      <%= if is_correct do %>
                        <.icon name="hero-check-circle" class="size-4 text-success shrink-0" />
                      <% end %>
                      <div class="flex items-center gap-2 w-24 sm:w-32 shrink-0">
                        <div class={[
                          "flex-1 h-2.5 rounded overflow-hidden",
                          is_correct && "bg-success/30",
                          !is_correct && "bg-base-300"
                        ]}>
                          <div
                            class={[
                              "h-full transition-all duration-300",
                              is_correct && "bg-success",
                              !is_correct && "bg-base-content/40"
                            ]}
                            style={"width: #{pct}%"}
                          >
                          </div>
                        </div>
                        <span class="tabular-nums text-xs sm:text-sm w-5 text-right">{count}</span>
                      </div>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>
        </div>

        <%!-- Winner banner + standings-or-skip section --%>
        <%= if @engine_state.standings_revealed do %>
          <div class="space-y-3 animate-fade-in-up">
            <h3 class="text-xl font-semibold">🏆 Platzierung</h3>
            <ol class="space-y-2" data-test="standings-list">
              <%= for {{id, name, total, delta}, rank} <- Enum.with_index(@standings_with_deltas) do %>
                <li
                  id={"standing-#{id}"}
                  class={[
                    "flex items-center gap-3 p-3 rounded-lg border",
                    rank == 0 && "border-warning bg-warning/10",
                    rank == 1 && "border-base-content/30 bg-base-200",
                    rank >= 2 && "border-base-300 bg-base-200"
                  ]}
                >
                  <span class="font-bold text-lg w-8 text-center shrink-0">
                    <%= cond do %>
                      <% rank == 0 -> %>
                        🥇
                      <% rank == 1 -> %>
                        🥈
                      <% rank == 2 -> %>
                        🥉
                      <% true -> %>
                        {rank + 1}
                    <% end %>
                  </span>
                  <span class="flex-1 font-semibold text-base sm:text-lg truncate">{name}</span>
                  <%= if delta > 0 do %>
                    <span class="badge badge-success badge-sm shrink-0">+{delta}</span>
                  <% end %>
                  <span class="tabular-nums text-xl font-bold shrink-0">{total}</span>
                </li>
              <% end %>
            </ol>
            <button phx-click="next_round" class="btn btn-primary btn-lg w-full text-lg">
              <.icon name="hero-chevron-right" class="size-5" /> Nächste Runde
            </button>
          </div>
        <% else %>
          <% winner =
            Enum.find(@engine_state.teams, fn t ->
              t.id == @engine_state.current_winner_team_id
            end) %>

          <%= if winner do %>
            <div class="alert alert-success text-lg font-semibold">
              <.icon name="hero-trophy" class="size-6 text-warning" />
              <span><strong>{winner.name}</strong> gewinnt die Runde!</span>
            </div>
          <% else %>
            <div class="alert alert-info text-base">
              <.icon name="hero-hand-raised" class="size-5" />
              <span>Remis! Kein eindeutiger Gewinner.</span>
            </div>
          <% end %>

          <div class="flex flex-col gap-2">
            <button phx-click="show_standings" class="btn btn-primary btn-lg text-base">
              <.icon name="hero-clipboard" class="size-5" /> Team-Ergebnisse anzeigen
            </button>
            <button phx-click="next_round" class="btn btn-soft btn-lg text-base">
              <.icon name="hero-bookmark" class="size-5" /> Überspringen — nächste Kategorie
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%!-- Finished phase --%>
    <%= if @engine_state.status == :finished do %>
      <div class="text-center mt-20 mb-6 animate-fade-in">
        <.icon name="hero-trophy" class="size-20 mx-auto text-warning" />
        <h2 class="text-3xl font-bold mt-2">Quiz beendet!</h2>
      </div>

      <%= if Map.get(@engine_state, :final_results_revealed, false) do %>
        <%!-- Winner — compact, minimal --%>
        <%= if @standings != [] do %>
          <% [first | _rest] = @standings %>
          <% {_, winner_name, winner_score} = first %>
          <div id="host-winner-line" class="text-center mb-6">
            <span class="text-xl font-semibold">
              <strong>{winner_name}</strong> gewinnt mit {winner_score} Punkten!
            </span>
          </div>
        <% else %>
          <div class="alert alert-warning text-lg">
            <.icon name="hero-exclamation-triangle" class="size-6" />
            <span>Keine Teams vorhanden.</span>
          </div>
        <% end %>
      <% else %>
        <div class="text-center mt-6">
          <button
            phx-click="reveal_final_results"
            class="btn btn-primary text-lg px-8 py-3"
          >
            Ergebnisse für Teams freigeben
          </button>
        </div>
      <% end %>

      <div class="mt-5 flex justify-center gap-3">
        <.link
          navigate={~p"/admin/events"}
          class="btn btn-soft text-base px-6 py-2.5"
        >
          <.icon name="hero-chevron-left" class="size-5" /> Zurück zur Übersicht
        </.link>
        <%= if Map.get(@engine_state, :final_results_revealed, false) do %>
          <.link
            navigate={~p"/admin/events/#{@event.id}/results"}
            class="btn btn-soft text-base px-6 py-2.5"
          >
            <.icon name="hero-clipboard" class="size-5" /> Antworten ansehen
          </.link>
        <% end %>
      </div>
    <% end %>
  </div>

  <.confirm_modal
    id="finish-quiz-modal"
    show={@confirm_action == :finish_quiz}
    title="Quiz beenden?"
    message="Quiz vorzeitig beenden?"
    confirm_label="Beenden"
    confirm_event="confirm_finish_quiz"
    cancel_event="cancel_confirm"
  />
</Layouts.app>
