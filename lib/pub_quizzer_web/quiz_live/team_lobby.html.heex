<Layouts.app
  flash={@flash}
  max_width="max-w-md"
  hide_nav_actions
  main_class="px-3 pt-1 pb-3 sm:pt-3 sm:pb-4 sm:px-4 lg:px-6"
>
  <%!-- Team name header always visible --%>
  <div class="text-center mt-3 mb-3">
    <h1 class="text-lg font-bold">{@team.name}</h1>
  </div>

  <%!-- Lobby: waiting for start --%>
  <%= if @engine_state.status == :lobby do %>
    <div class="text-center max-w-xs mx-auto animate-fade-in">
      <div class="alert shadow-md text-base border border-base-300 px-4 py-3">
        <.icon name="hero-clock" class="size-4" />
        <span class="font-semibold">Warte auf den Quiz-Start</span>
      </div>
      <p class="text-sm text-base-content/50 mt-3">
        Quiz-Code: <span class="font-mono font-bold">{@event.code}</span>
      </p>
    </div>
  <% end %>

  <%!-- Topic selection: team votes or waits --%>
  <%= if @engine_state.status == :topic_selection do %>
    <div class="text-center mb-4 mt-8 animate-fade-in">
      <%= if @engine_state.current_chooser_team_id == @team.id do %>
        <div class="alert alert-success mb-3 text-sm px-3 py-2">
          <.icon name="hero-trophy" class="size-4" />
          <span><strong>Dein Team hat Runde {@engine_state.round_number} gewonnen!</strong>
          Sag dem Moderator dein gewünschtes Thema.</span>
        </div>
      <% else %>
        <% chooser =
          Enum.find(@engine_state.teams, fn t ->
            t.id == @engine_state.current_chooser_team_id
          end) %>
        <div class="alert alert-info text-sm px-3 py-2">
          <.icon name="hero-sparkles" class="size-4" />
          <span>
            <%= if chooser do %>
              <strong>{chooser.name}</strong>
              hat Runde {@engine_state.round_number} gewonnen und hat Vortritt.
            <% else %>
              Der Moderator wählt ein Thema...
            <% end %>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>

  <%!-- Question phase: topic and choices; the prompt is shown by the moderator --%>
  <%= if @engine_state.status == :question do %>
    <% our_answer =
      Map.get(Map.get(@engine_state.answers, @engine_state.question_index, %{}), @team.id) %>
    <% question = Enum.at(@engine_state.current_questions, @engine_state.question_index) %>

    <div class="mb-4 animate-fade-in">
      <div class="flex items-start justify-between gap-3 mb-5">
        <div class="min-w-0">
          <%= if @current_topic_name do %>
            <h2 id="team-question-topic" class="text-xl font-bold leading-tight break-words mb-1">
              {@current_topic_name}
            </h2>
          <% end %>
          <p id="team-question-progress" class="text-base font-semibold tabular-nums">
            Frage {(@engine_state.question_index || 0) + 1} / {length(
              @engine_state.current_questions
            )}
          </p>
        </div>
        <span
          id="team-question-timer"
          phx-hook=".QuestionTimer"
          phx-update="ignore"
          data-question-key={"#{@engine_state.round_number}-#{question.id}"}
          role="timer"
          aria-label="Zeit für diese Frage"
          aria-live="off"
          class="inline-flex items-center gap-1.5 text-sm shrink-0 tabular-nums"
        >
          <.icon name="hero-clock" class="size-4" />
          <span data-timer-value>00:00</span>
        </span>
      </div>

      <div class="flex flex-col gap-2">
        <%= for {option, idx} <- Enum.with_index(question.options) do %>
          <% is_selected = @selected_index == idx or our_answer == idx %>
          <button
            phx-click="select_answer"
            phx-value-index={idx}
            phx-value-question_id={question.id}
            class={[
              "btn h-auto min-h-16 w-full px-3 py-3 justify-start gap-3 text-left whitespace-normal break-words shadow-sm border transition-[color,background-color,border-color,transform] duration-200 ease-out active:scale-[0.98]",
              is_selected && "btn-primary",
              !is_selected &&
                "bg-base-200 border-[3px] border-base-content/40 hover:bg-base-300 hover:border-base-content/70"
            ]}
          >
            <span class="font-mono font-bold text-xl shrink-0 w-7 text-center">
              {letter_for_index(idx)}
            </span>
            <span class="min-w-0 flex-1 text-sm font-medium leading-snug">{option["text"]}</span>
          </button>
        <% end %>
      </div>
    </div>
  <% end %>

  <%!-- Round reveal: winner shown immediately; standings gated behind moderator trigger --%>
  <%= if @engine_state.status == :round_reveal do %>
    <div class="mb-3 animate-fade-in">
      <%= if @engine_state.current_winner_team_id == @team.id do %>
        <div class="alert alert-success text-sm px-3 py-2">
          <.icon name="hero-trophy" class="size-4" />
          <span><strong>Dein Team hat Runde {(@engine_state.round_number || 0) + 1} gewonnen!</strong></span>
        </div>
      <% else %>
        <% winner =
          Enum.find(@engine_state.teams, fn t ->
            t.id == @engine_state.current_winner_team_id
          end) %>
        <%= if winner do %>
          <div class="alert alert-info text-sm px-3 py-2">
            <.icon name="hero-trophy" class="size-4" />
            <span>{winner.name} hat Runde {(@engine_state.round_number || 0) + 1} gewonnen</span>
          </div>
        <% else %>
          <div class="alert alert-info text-sm px-3 py-2">
            <.icon name="hero-hand-raised" class="size-4" />
            <span>Remis! Kein eindeutiger Gewinner.</span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= if @engine_state.standings_revealed do %>
      <div class="text-center mb-4">
        <span class="text-lg font-bold">Platzierung</span>
      </div>
      <div class="space-y-2">
        <%= for {{id, name, score}, rank} <- Enum.with_index(@standings) do %>
          <.podium_row
            id={"team-standing-#{id}"}
            rank={rank}
            name={name}
            score={score}
            size="sm"
          >
            <%= if @team.id == id do %>
              <span class="text-xs font-normal">(du)</span>
            <% end %>
          </.podium_row>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%!-- Finished phase --%>
  <%= if @engine_state.status == :finished do %>
    <div class="text-center mb-4 animate-fade-in">
      <.icon name="hero-trophy" class="size-12 mx-auto text-warning" />
      <h2 class="text-lg font-bold mt-2">Quiz beendet!</h2>
    </div>

    <%= if Map.get(@engine_state, :final_results_revealed, false) do %>
      <%= if @standings != [] do %>
        <% [first | _rest] = @standings %>
        <% {winner_id, winner_name, winner_score} = first %>
        <div
          id="team-winner-alert"
          class="alert alert-success mb-3 text-sm px-3 py-2"
          phx-hook={if @team.id == winner_id, do: "Confetti"}
          data-intensity="normal"
        >
          <.icon name="hero-star" class="size-4" />
          <span><strong>{winner_name}</strong> gewinnt mit {winner_score} Punkten!</span>
        </div>

        <div class="text-center mb-4">
          <span class="text-lg font-bold">Endplatzierung</span>
        </div>
        <div class="space-y-2">
          <%= for {{id, name, score}, rank} <- Enum.with_index(@standings) do %>
            <.podium_row
              id={"team-final-#{id}"}
              rank={rank}
              name={name}
              score={score}
              size="sm"
              class={if @team.id == id, do: "font-bold"}
            >
              <%= if @team.id == id do %>
                <span class="text-xs font-normal">(du)</span>
              <% end %>
            </.podium_row>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-warning text-sm px-3 py-2">
          <.icon name="hero-exclamation-triangle" class="size-4" />
          <span>Keine Teams vorhanden.</span>
        </div>
      <% end %>
    <% else %>
      <div class="text-center max-w-xs mx-auto mt-8">
        <div class="alert shadow-md text-base border border-base-300 px-4 py-3">
          <.icon name="hero-eye" class="size-4" />
          <span class="font-semibold">Moderator hat das Quiz beendet, gleich gibt es die Ergebnisse</span>
        </div>
      </div>
    <% end %>
  <% end %>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".QuestionTimer">
    export default {
      mounted() {
        this.reset()
      },
      updated() {
        if (this.questionKey !== this.el.dataset.questionKey) this.reset()
      },
      destroyed() {
        clearInterval(this.interval)
      },
      reset() {
        clearInterval(this.interval)
        this.questionKey = this.el.dataset.questionKey
        this.startedAt = performance.now()
        this.value = this.el.querySelector("[data-timer-value]")
        this.tick()
        this.interval = setInterval(() => this.tick(), 1000)
      },
      tick() {
        const seconds = Math.floor((performance.now() - this.startedAt) / 1000)
        const minutes = String(Math.floor(seconds / 60)).padStart(2, "0")
        const remainder = String(seconds % 60).padStart(2, "0")
        this.value.textContent = `${minutes}:${remainder}`
      }
    }
  </script>
</Layouts.app>
