<Layouts.app
  flash={@flash}
  max_width="max-w-md"
  hide_nav_actions
  main_class="px-3 pt-1 pb-3 sm:pt-3 sm:pb-4 sm:px-4 lg:px-6"
>
  <%!-- Team name header always visible --%>
  <div class="text-center mt-3 mb-3">
    <h1 class="text-lg font-bold">{@team.name}</h1>
  </div>

  <%!-- Lobby: waiting for start --%>
  <%= if @engine_state.status == :lobby do %>
    <div class="text-center max-w-xs mx-auto">
      <div class="alert shadow-md text-base border border-base-300 px-4 py-3">
        <.icon name="hero-clock" class="size-4" />
        <span class="font-semibold">Warte auf den Quiz-Start</span>
      </div>
      <p class="text-sm text-base-content/50 mt-3">
        Quiz-Code: <span class="font-mono font-bold">{@event.code}</span>
      </p>
    </div>
  <% end %>

  <%!-- Topic selection: team votes or waits --%>
  <%= if @engine_state.status == :topic_selection do %>
    <div class="text-center mb-4 mt-8">
      <%= if @engine_state.current_chooser_team_id == @team.id do %>
        <div class="alert alert-success mb-3 text-sm px-3 py-2">
          <.icon name="hero-trophy" class="size-4" />
          <span><strong>Dein Team hat Runde {@engine_state.round_number} gewonnen!</strong>
          Sag dem Moderator dein gewünschtes Thema.</span>
        </div>
      <% else %>
        <% chooser =
          Enum.find(@engine_state.teams, fn t ->
            t.id == @engine_state.current_chooser_team_id
          end) %>
        <div class="alert alert-info text-sm px-3 py-2">
          <.icon name="hero-sparkles" class="size-4" />
          <span>
            <%= if chooser do %>
              <strong>{chooser.name}</strong>
              hat Runde {@engine_state.round_number} gewonnen und hat Vortritt.
            <% else %>
              Der Moderator wählt ein Thema...
            <% end %>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>

  <%!-- Question phase: teams only see A/B/C/D buttons, beamer is the source --%>
  <%= if @engine_state.status == :question do %>
    <% answered = PubQuizzer.Quiz.EngineState.answered_teams(@engine_state) %>
    <% our_answer =
      Map.get(Map.get(@engine_state.answers, @engine_state.question_index, %{}), @team.id) %>

    <div class="mb-4">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h3 class="text-sm font-semibold">
            Frage {(@engine_state.question_index || 0) + 1} / {length(
              @engine_state.current_questions
            )}
          </h3>
          <%= if @current_topic_name do %>
            <span class="text-xs text-base-content/60">{@current_topic_name}</span>
          <% end %>
        </div>
        <span class="badge badge-ghost badge-sm text-xs">
          {MapSet.size(answered)} / {length(@engine_state.teams)} geantwortet
        </span>
      </div>

      <div class="flex flex-col gap-2">
        <%= for {_option, shuffled_idx} <- Enum.with_index(@shuffled_options) do %>
          <% is_selected =
            @selected_index == shuffled_idx or
              (our_answer != nil and
                 OptionShuffle.to_shuffled(@shuffle_map, our_answer) == shuffled_idx) %>
          <button
            phx-click="select_answer"
            phx-value-index={shuffled_idx}
            class={[
              "btn h-auto w-full py-4 justify-center text-center shadow-lg border text-xl font-bold",
              is_selected && "btn-primary",
              !is_selected &&
                "bg-base-200 border-[3px] border-base-content/40 hover:bg-base-300 hover:border-base-content/70"
            ]}
          >
            <span class="font-mono font-bold text-3xl">
              {String.capitalize(Enum.at(["a", "b", "c", "d", "e", "f"], shuffled_idx, ""))}
            </span>
          </button>
        <% end %>
      </div>
    </div>

    <%= if our_answer != nil do %>
      <div class="alert alert-success shadow-sm text-sm mt-3 px-3 py-2">
        <.icon name="hero-check-circle" class="size-5" />
        <span class="font-semibold">Antwort abgegeben!</span>
      </div>
    <% end %>
  <% end %>

  <%!-- Round reveal: show scores --%>
  <%= if @engine_state.status == :round_reveal do %>
    <div class="mb-3">
      <%= if @engine_state.current_winner_team_id == @team.id do %>
        <div class="alert alert-success text-sm px-3 py-2">
          <.icon name="hero-trophy" class="size-4" />
          <span><strong>Dein Team hat Runde {(@engine_state.round_number || 0) + 1} gewonnen!</strong></span>
        </div>
      <% else %>
        <% winner =
          Enum.find(@engine_state.teams, fn t -> t.id == @engine_state.current_winner_team_id end) %>
        <%= if winner do %>
          <div class="alert alert-info text-sm px-3 py-2">
            <.icon name="hero-trophy" class="size-4" />
            <span>{winner.name} hat Runde {(@engine_state.round_number || 0) + 1} gewonnen</span>
          </div>
        <% else %>
          <div class="alert alert-info text-sm px-3 py-2">
            <.icon name="hero-hand-raised" class="size-4" />
            <span>Remis! Kein eindeutiger Gewinner.</span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= if @engine_state.standings_revealed do %>
      <div class="text-center mb-4">
        <span class="text-lg font-bold">Platzierung</span>
      </div>
      <div class="space-y-2">
        <%= for {{id, name, score}, rank} <- Enum.with_index(@standings) do %>
          <div
            id={"team-standing-#{id}"}
            class={[
              "flex items-center gap-3 rounded-lg px-4 py-3 shadow-sm",
              rank == 0 && "bg-warning/20 border border-warning",
              rank == 1 && "bg-base-300",
              rank == 2 && "bg-amber-800/20",
              rank > 2 && "bg-base-200"
            ]}
          >
            <span class={[
              "flex items-center justify-center w-8 h-8 rounded-full text-base font-bold shrink-0",
              rank == 0 && "bg-warning text-warning-content",
              rank == 1 && "bg-base-content/20 text-base-content",
              rank == 2 && "bg-amber-800 text-amber-100",
              rank > 2 && "bg-base-content/20 text-base-content"
            ]}>
              {rank + 1}
            </span>
            <span class={[
              "flex-1 text-sm font-semibold",
              rank == 0 && "text-base-content",
              @team.id == id && "font-bold"
            ]}>
              {name}
              <%= if @team.id == id do %>
                <span class="text-xs font-normal">(du)</span>
              <% end %>
            </span>
            <span class={[
              "badge text-sm py-1 px-3 font-bold",
              rank == 0 && "badge-warning",
              rank == 1 && "badge-primary",
              rank == 2 && "badge-primary",
              rank > 2 && "badge-ghost"
            ]}>{score}</span>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%!-- Finished phase --%>
  <%= if @engine_state.status == :finished do %>
    <div class="text-center mb-4">
      <.icon name="hero-trophy" class="size-12 mx-auto text-warning" />
      <h2 class="text-lg font-bold mt-2">Quiz beendet!</h2>
    </div>

    <%= if @standings != [] do %>
      <% [first | _rest] = @standings %>
      <% {_, winner_name, winner_score} = first %>
      <div class="alert alert-success mb-3 text-sm px-3 py-2">
        <.icon name="hero-star" class="size-4" />
        <span><strong>{winner_name}</strong> gewinnt mit {winner_score} Punkten!</span>
      </div>

      <div class="text-center mb-4">
        <span class="text-lg font-bold">Endplatzierung</span>
      </div>
      <div class="space-y-2">
        <%= for {{id, name, score}, rank} <- Enum.with_index(@standings) do %>
          <div
            id={"team-final-#{id}"}
            class={[
              "flex items-center gap-3 rounded-lg px-4 py-3 shadow-sm",
              rank == 0 && "bg-warning/20 border border-warning",
              rank == 1 && "bg-base-300",
              rank == 2 && "bg-amber-800/20",
              rank > 2 && "bg-base-200"
            ]}
          >
            <span class={[
              "flex items-center justify-center w-8 h-8 rounded-full text-base font-bold shrink-0",
              rank == 0 && "bg-warning text-warning-content",
              rank == 1 && "bg-base-content/20 text-base-content",
              rank == 2 && "bg-amber-800 text-amber-100",
              rank > 2 && "bg-base-content/20 text-base-content"
            ]}>
              {rank + 1}
            </span>
            <span class={[
              "flex-1 text-sm font-semibold",
              rank == 0 && "text-base-content",
              @team.id == id && "font-bold"
            ]}>
              {name}
              <%= if @team.id == id do %>
                <span class="text-xs font-normal">(du)</span>
              <% end %>
            </span>
            <span class={[
              "badge text-sm py-1 px-3 font-bold",
              rank == 0 && "badge-warning",
              rank == 1 && "badge-primary",
              rank == 2 && "badge-primary",
              rank > 2 && "badge-ghost"
            ]}>{score}</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert alert-warning text-sm px-3 py-2">
        <.icon name="hero-exclamation-triangle" class="size-4" />
        <span>Keine Teams vorhanden.</span>
      </div>
    <% end %>
  <% end %>
</Layouts.app>
