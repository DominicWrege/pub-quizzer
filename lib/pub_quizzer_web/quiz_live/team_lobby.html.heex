<Layouts.app
  flash={@flash}
  max_width="max-w-md"
  hide_nav_actions
  main_class="px-4 py-4 sm:pt-4 sm:pb-6 sm:px-6 lg:px-8"
>
  <%!-- Team name header always visible --%>
  <div class="text-center mb-6">
    <h1 class="text-2xl font-bold">{@team.name}</h1>
  </div>

  <%!-- Lobby: waiting for start --%>
  <%= if @engine_state.status == :lobby do %>
    <div class="text-center max-w-sm mx-auto">
      <div class="alert shadow-lg text-lg border border-base-300">
        <.icon name="hero-clock" class="size-5 lg:size-4" />
        <span class="font-semibold">Warte auf den Start des Quiz...</span>
      </div>
      <p class="text-base text-base-content/50 mt-4">
        Quiz-Code: <span class="font-mono font-bold">{@event.code}</span>
      </p>
    </div>
  <% end %>

  <%!-- Topic selection: team votes or waits --%>
  <%= if @engine_state.status == :topic_selection do %>
    <div class="text-center mb-6 mt-32">
      <%= if @engine_state.current_chooser_team_id == @team.id do %>
        <div class="alert alert-success mb-4">
          <.icon name="hero-trophy" class="size-5" />
          <span><strong>Dein Team hat Runde {@engine_state.round_number} gewonnen!</strong>
          Sag dem Moderator dein gewünschtes Thema.</span>
        </div>
      <% else %>
        <% chooser =
          Enum.find(@engine_state.teams, fn t ->
            t.id == @engine_state.current_chooser_team_id
          end) %>
        <div class="alert alert-info">
          <.icon name="hero-sparkles" class="size-5" />
          <span>
            <%= if chooser do %>
              <strong>{chooser.name}</strong>
              hat Runde {@engine_state.round_number} gewonnen und hat Vortritt.
            <% else %>
              Der Moderator wählt ein Thema...
            <% end %>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>

  <%!-- Question phase: teams only see A/B/C/D buttons, beamer is the source --%>
  <%= if @engine_state.status == :question do %>
    <% answered = PubQuizzer.Quiz.EngineState.answered_teams(@engine_state) %>
    <% our_answer =
      Map.get(Map.get(@engine_state.answers, @engine_state.question_index, %{}), @team.id) %>

    <div class="mb-6">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-semibold">
          Frage {(@engine_state.question_index || 0) + 1} / {length(
            @engine_state.current_questions
          )}
        </h3>
        <span class="badge badge-ghost">
          {MapSet.size(answered)} / {length(@engine_state.teams)} geantwortet
        </span>
      </div>

      <div class="flex flex-col gap-4">
        <%= for {_option, shuffled_idx} <- Enum.with_index(@shuffled_options) do %>
          <% is_selected =
            @selected_index == shuffled_idx or
              (our_answer != nil and
                 OptionShuffle.to_shuffled(@shuffle_map, our_answer) == shuffled_idx) %>
          <button
            phx-click="select_answer"
            phx-value-index={shuffled_idx}
            class={[
              "btn h-auto w-full py-8 justify-center text-center shadow-md border",
              is_selected && "btn-primary",
              !is_selected &&
                "bg-transparent border-base-content/20 hover:border-base-content/50"
            ]}
          >
            <span class="font-mono font-bold text-5xl">
              {String.capitalize(Enum.at(["a", "b", "c", "d", "e", "f"], shuffled_idx, ""))}
            </span>
            <%= if is_selected do %>
              <.icon name="hero-check-circle" class="size-8 shrink-0 ml-4" />
            <% end %>
          </button>
        <% end %>
      </div>
    </div>

    <%= if our_answer != nil do %>
      <div class="alert alert-success shadow-md text-base mt-4">
        <.icon name="hero-check-circle" class="size-7" />
        <span class="font-bold">Antwort abgegeben! Du kannst sie ändern, bis der Moderator weitermacht.</span>
      </div>
    <% end %>
  <% end %>

  <%!-- Round reveal: show scores --%>
  <%= if @engine_state.status == :round_reveal do %>
    <div class="mb-4">
      <%= if @engine_state.current_winner_team_id == @team.id do %>
        <div class="alert alert-success">
          <.icon name="hero-trophy" class="size-5" />
          <span><strong>Dein Team hat Runde {(@engine_state.round_number || 0) + 1} gewonnen!</strong></span>
        </div>
      <% else %>
        <% winner =
          Enum.find(@engine_state.teams, fn t -> t.id == @engine_state.current_winner_team_id end) %>
        <%= if winner do %>
          <div class="alert alert-info">
            <.icon name="hero-trophy" class="size-5" />
            <span>{winner.name} hat Runde {(@engine_state.round_number || 0) + 1} gewonnen</span>
          </div>
        <% else %>
          <div class="alert alert-info">
            <.icon name="hero-hand-raised" class="size-5" />
            <span>Remis! Kein eindeutiger Gewinner.</span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= if @engine_state.standings_revealed do %>
      <div class="text-center mb-6">
        <span class="text-2xl font-bold">Platzierung</span>
      </div>
      <div class="space-y-3">
        <%= for {{id, name, score}, rank} <- Enum.with_index(@standings) do %>
          <div
            id={"team-standing-#{id}"}
            class={[
              "flex items-center gap-4 rounded-xl px-5 py-4 shadow",
              rank == 0 && "bg-warning/20 border border-warning",
              rank == 1 && "bg-base-300",
              rank == 2 && "bg-amber-800/20",
              rank > 2 && "bg-base-200"
            ]}
          >
            <span class={[
              "flex items-center justify-center w-12 h-12 rounded-full text-2xl font-bold shrink-0",
              rank == 0 && "bg-warning text-warning-content",
              rank == 1 && "bg-base-content/20 text-base-content",
              rank == 2 && "bg-amber-800 text-amber-100",
              rank > 2 && "bg-base-content/20 text-base-content"
            ]}>
              {rank + 1}
            </span>
            <span class={[
              "flex-1 text-xl font-semibold",
              rank == 0 && "text-warning",
              @team.id == id && "font-bold"
            ]}>
              {name}
              <%= if @team.id == id do %>
                <span class="text-sm font-normal">(du)</span>
              <% end %>
            </span>
            <span class={[
              "badge text-lg py-2 px-4 font-bold",
              rank == 0 && "badge-warning",
              rank == 1 && "badge-primary",
              rank == 2 && "badge-primary",
              rank > 2 && "badge-ghost"
            ]}>{score}</span>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%!-- Finished phase --%>
  <%= if @engine_state.status == :finished do %>
    <div class="text-center mb-6">
      <.icon name="hero-trophy" class="size-[4rem] mx-auto text-warning" />
      <h2 class="text-2xl font-bold mt-4">Quiz beendet!</h2>
    </div>

    <%= if @standings != [] do %>
      <% [first | _rest] = @standings %>
      <% {_, winner_name, winner_score} = first %>
      <div class="alert alert-success mb-4">
        <.icon name="hero-star" class="size-5" />
        <span><strong>{winner_name}</strong> gewinnt mit {winner_score} Punkten!</span>
      </div>

      <div class="text-center mb-6">
        <span class="text-2xl font-bold">Endplatzierung</span>
      </div>
      <div class="space-y-3">
        <%= for {{id, name, score}, rank} <- Enum.with_index(@standings) do %>
          <div
            id={"team-final-#{id}"}
            class={[
              "flex items-center gap-4 rounded-xl px-5 py-4 shadow",
              rank == 0 && "bg-warning/20 border border-warning",
              rank == 1 && "bg-base-300",
              rank == 2 && "bg-amber-800/20",
              rank > 2 && "bg-base-200"
            ]}
          >
            <span class={[
              "flex items-center justify-center w-12 h-12 rounded-full text-2xl font-bold shrink-0",
              rank == 0 && "bg-warning text-warning-content",
              rank == 1 && "bg-base-content/20 text-base-content",
              rank == 2 && "bg-amber-800 text-amber-100",
              rank > 2 && "bg-base-content/20 text-base-content"
            ]}>
              {rank + 1}
            </span>
            <span class={[
              "flex-1 text-xl font-semibold",
              rank == 0 && "text-warning",
              @team.id == id && "font-bold"
            ]}>
              {name}
              <%= if @team.id == id do %>
                <span class="text-sm font-normal">(du)</span>
              <% end %>
            </span>
            <span class={[
              "badge text-lg py-2 px-4 font-bold",
              rank == 0 && "badge-warning",
              rank == 1 && "badge-primary",
              rank == 2 && "badge-primary",
              rank > 2 && "badge-ghost"
            ]}>{score}</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert alert-warning">
        <.icon name="hero-exclamation-triangle" class="size-5" />
        <span>Keine Teams vorhanden.</span>
      </div>
    <% end %>
  <% end %>
</Layouts.app>
